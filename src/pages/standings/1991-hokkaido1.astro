---
import SiteHeader from "../../components/SiteHeader.astro";
import { team as muroran } from "../../data/teams/shin-nittetsu-muroran-1991.js";
import { manualStandings } from "../../data/standings/hokkaido-1991.js";

// 新日鐵室蘭は既存のチームデータから自動取得
const muroranLeague = muroran.results.league;

const muroranStanding = {
  name: muroran.name,
  url: "/teams/shin-nittetsu-muroran-1991",
  rank: muroranLeague.rank,
  points: muroranLeague.points,
  wins: muroranLeague.wins,
  draws: muroranLeague.draws,
  losses: muroranLeague.losses,
  goalsFor: muroranLeague.goalsFor,
  goalsAgainst: muroranLeague.goalsAgainst,
  goalDifference: muroranLeague.goalDifference ?? "",
};

// 手動登録7チームと新日鐵室蘭を統合
const standings = [
  ...manualStandings,
  muroranStanding,
].sort((a, b) => Number(a.rank) - Number(b.rank));

const show = (value) =>
  value === null || value === undefined ? "" : value;

const showGoalDifference = (value) => {
  if (value === null || value === undefined || value === "") {
    return "";
  }

  return Number(value) > 0 && !String(value).startsWith("+")
    ? `+${value}`
    : value;
};

const isRelegated = (rank) => Number(rank) === 8;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="1991年 第14回北海道サッカーリーグ１部の最終順位表。参加8チームの勝点・勝敗・得失点などを掲載。"
    />
    <title>
      1991 第14回北海道サッカーリーグ１部 順位表 | 日本クラブサッカーアーカイブ
    </title>
  </head>

  <body>
  <SiteHeader currentPath={Astro.url.pathname} />
    <main>
      <p class="back">
        <a href="/standings/">← 順位表一覧へ戻る</a>
      </p>

      <nav class="season-navigation" aria-label="前後シーズン">
        <div class="season-nav-item">
          <span class="season-nav-label">前シーズン</span>
          <span class="season-nav-unlinked">1990</span>
        </div>

        <div class="season-nav-item next">
          <span class="season-nav-label">次シーズン</span>
          <span class="season-nav-unlinked">1992</span>
        </div>
      </nav>

      <header class="league-header">
        <h1 class="league-heading">
          <span>1991</span>
          <span>第14回北海道サッカーリーグ１部</span>
        </h1>

        <div class="league-profile">
          <p>参加チーム数：{standings.length}</p>
        </div>
      </header>

      <section class="archive-section">
        <h2>最終順位表</h2>

        <div class="table-scroll">
          <table class="standings-table">
            <thead>
              <tr>
                <th class="rank-column">順位</th>
                <th class="team-column">チーム</th>
                <th class="stat-column">勝点</th>
                <th class="stat-column">勝</th>
                <th class="stat-column">分</th>
                <th class="stat-column">敗</th>
                <th class="stat-column">得点</th>
                <th class="stat-column">失点</th>
                <th class="difference-column">得失点差</th>
              </tr>
            </thead>

            <tbody>
              {
                standings.map((item) => (
                  <tr>
                    <td class="rank-cell">
  <span class="rank-content">
    {isRelegated(item.rank) && (
      <span
        class="relegation-arrow"
        aria-label="北海道サッカーリーグ２部降格"
        title="北海道サッカーリーグ２部降格"
      >
        ▼
      </span>
    )}
    {show(item.rank)}
  </span>
</td>

                    <td class="team-name">
                      {item.url ? (
                        <a href={item.url}>{item.name}</a>
                      ) : (
                        item.name
                      )}
                    </td>

                    <td class="points-cell">{show(item.points)}</td>
                    <td class="number">{show(item.wins)}</td>
                    <td class="number">{show(item.draws)}</td>
                    <td class="number">{show(item.losses)}</td>
                    <td class="number">{show(item.goalsFor)}</td>
                    <td class="number">{show(item.goalsAgainst)}</td>
                    <td class="number">
                      {showGoalDifference(item.goalDifference)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="table-note">
          <span class="relegation-arrow">▼</span>
          <span>北海道サッカーリーグ２部降格</span>
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Noto Sans JP", sans-serif;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 90px;
  }

  .back {
    margin: 0 0 28px;
    font-size: 14px;
  }

  .back a {
    color: #68716b;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
  }

  .season-navigation {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
    padding: 14px 0;
    border-top: 1px solid #cfd5d0;
    border-bottom: 1px solid #cfd5d0;
  }

  .season-nav-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .season-nav-item.next {
    text-align: right;
  }

  .season-nav-label {
    color: #68716b;
    font-size: 12px;
  }

  .season-nav-unlinked {
    color: #68716b;
    font-size: 14px;
    font-weight: 700;
  }

  .league-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  .league-heading span {
    display: block;
  }

  .league-profile {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #cfd5d0;
  }

  .league-profile p {
    margin: 7px 0;
    font-size: 15px;
    color: #68716b;
  }

  .archive-section {
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid #cfd5d0;
  }

  .archive-section h2 {
    margin: 0 0 25px;
    font-size: 22px;
  }

  .table-scroll {
    width: 100%;
    overflow-x: auto;
    background: #fff;
    border: 2px solid #7f8982;
  }

  table {
    border-collapse: collapse;
    background: #fff;
    font-size: 14px;
  }

  .standings-table {
    width: 100%;
    min-width: 790px;
    table-layout: fixed;
  }

  th,
  td {
    border: 1px solid #8f9992;
    padding: 12px 10px;
    vertical-align: middle;
  }

  table tr:first-child th {
    border-top: 0;
  }

  table tr:last-child td {
    border-bottom: 0;
  }

  table th:first-child,
  table td:first-child {
    border-left: 0;
  }

  table th:last-child,
  table td:last-child {
    border-right: 0;
  }

  th {
    background: #dde3df;
    color: #202522;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }

  .rank-column {
    width: 72px;
  }

  .team-column {
    width: 300px;
    text-align: left;
    padding-left: 15px;
  }

  .stat-column {
    width: 80px;
  }

  .difference-column {
    width: 100px;
  }

  .rank-cell {
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .rank-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .relegation-arrow {
    color: #b63d36;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .team-name {
    padding-left: 15px;
    font-weight: 500;
    white-space: nowrap;
  }

  .team-name a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
  }

  .team-name a:hover {
    text-decoration: underline;
  }

  .points-cell {
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: #f3f5f3;
  }

  .number {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  tbody tr:hover td {
    background: #f3f5f3;
  }

  tbody tr:hover .points-cell {
    background: #e7ebe8;
  }

  .table-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 13px 0 0;
    font-size: 13px;
    color: #68716b;
  }

  @media (max-width: 600px) {
    main {
      width: calc(100% - 24px);
      padding-top: 30px;
    }

    .back {
      margin-bottom: 24px;
    }

    .season-navigation {
      gap: 12px;
      margin-bottom: 30px;
    }

    .league-heading {
      font-size: 26px;
      gap: 6px;
    }

    .archive-section {
      margin-top: 45px;
    }

    th,
    td {
      padding: 10px 8px;
    }
  }
</style>