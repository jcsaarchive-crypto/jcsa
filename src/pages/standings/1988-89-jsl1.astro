      width: calc(100% - 24px);
      padding-top: 30px;
    }

    .back {
      margin-bottom: 40px;
    }

    .league-heading {
      font-size: 26px;
      gap: 6px;
    }

    .archive-section {
      margin-top: 45px;
    }

    th,
    td {
      padding: 10px 8px;
    }
  }
</style>
