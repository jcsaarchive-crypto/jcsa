    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP", sans-serif;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 90px;
  }

  .back {
    margin: 0 0 55px;
    font-size: 14px;
  }

  .back a {
    color: #68716b;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
  }

  .league-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  .league-heading span {
    display: block;
  }

  .league-profile {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #cfd5d0;
  }

  .league-profile p {
    margin: 7px 0;
    font-size: 15px;
    color: #68716b;
  }

  .archive-section {
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid #cfd5d0;
  }

  .archive-section h2 {
    margin: 0 0 25px;
    font-size: 22px;
  }

  .table-scroll {
    width: 100%;
    overflow-x: auto;
    background: #ffffff;
    border: 2px solid #7f8982;
  }

  table {
    border-collapse: collapse;
    background: #ffffff;
    font-size: 14px;
  }

  .standings-table {
    width: 100%;
    min-width: 790px;
    table-layout: fixed;
  }

  th,
  td {
    border: 1px solid #8f9992;
    padding: 12px 10px;
    vertical-align: middle;
  }

  table tr:first-child th {
    border-top: 0;
  }

  table tr:last-child td {
    border-bottom: 0;
  }

  table th:first-child,
  table td:first-child {
    border-left: 0;
  }

  table th:last-child,
  table td:last-child {
    border-right: 0;
  }

  th {
    background: #dde3df;
    color: #202522;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }

  .rank-column {
    width: 72px;
  }

  .team-column {
    width: 300px;
    text-align: left;
    padding-left: 15px;
  }

  .stat-column {
    width: 80px;
  }

  .difference-column {
    width: 100px;
  }

  .rank-cell {
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .rank-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .relegation-arrow {
    color: #b63d36;
