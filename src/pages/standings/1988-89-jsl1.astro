  }

  .team-name a:hover {
    text-decoration: underline;
  }

  .points-cell {
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: #f3f5f3;
  }

  .number {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  tbody tr:hover td {
    background: #f3f5f3;
  }

  tbody tr:hover .points-cell {
    background: #e7ebe8;
  }

  .table-note {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 13px 0 0;
    font-size: 13px;
    color: #68716b;
  }

  @media (max-width: 600px) {
