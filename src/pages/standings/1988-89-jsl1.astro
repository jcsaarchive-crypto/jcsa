
---
import { team as nissan } from "../../data/teams/nissan-motors-88-89.js";
import { team as ana } from "../../data/teams/ana-soccer-club-88-89.js";
import { team as yamaha } from "../../data/teams/yamaha-88-89.js";
import { team as fujita } from "../../data/teams/fujita-kogyo-88-89.js";
import { team as yomiuri } from "../../data/teams/yomiuri-soccer-club-88-89.js";
import { team as furukawa } from "../../data/teams/furukawa-electric-88-89.js";
import { team as matsushita } from "../../data/teams/matsushita-electric-88-89.js";
import { team as yanmar } from "../../data/teams/yanmar-diesel-88-89.js";
import { team as honda } from "../../data/teams/honda-giken-88-89.js";
import { team as nkk } from "../../data/teams/nkk-88-89.js";
import { team as sumitomo } from "../../data/teams/sumitomo-metal-industries-88-89.js";
import { team as mitsubishi } from "../../data/teams/mitsubishi-heavy-industries-88-89.js";

const teams = [
  { data: nissan, url: "/teams/nissan-motors-88-89" },
  { data: ana, url: "/teams/ana-soccer-club-88-89" },
  { data: yamaha, url: "/teams/yamaha-88-89" },
  { data: fujita, url: "/teams/fujita-kogyo-88-89" },
  { data: yomiuri, url: "/teams/yomiuri-soccer-club-88-89" },
  { data: furukawa, url: "/teams/furukawa-electric-88-89" },
  { data: matsushita, url: "/teams/matsushita-electric-88-89" },
  { data: yanmar, url: "/teams/yanmar-diesel-88-89" },
  { data: honda, url: "/teams/honda-giken-88-89" },
  { data: nkk, url: "/teams/nkk-88-89" },
  { data: sumitomo, url: "/teams/sumitomo-metal-industries-88-89" },
  { data: mitsubishi, url: "/teams/mitsubishi-heavy-industries-88-89" },
];

const standings = teams
  .map(({ data, url }) => ({
    name: data.name,
    url,
    ...data.results.league,
  }))
  .sort((a, b) => a.rank - b.rank);

const show = (value) => {
  if (value === null || value === undefined) return "";
  return value;
};

const showGoalDifference = (value) => {
  if (value === null || value === undefined || value === "") return "";
  return Number(value) > 0 ? `+${value}` : value;
};

const isRelegated = (rank) => Number(rank) === 11 || Number(rank) === 12;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>1988/89 第24回日本サッカーリーグ1部 JSL1部 順位表 | 日本クラブサッカーアーカイブ</title>
  </head>

  <body>
    <main>
      <p class="back">
        <a href="/">← トップへ戻る</a>
      </p>

      <header class="league-header">
        <h1 class="league-heading">
          <span>1988/89</span>
          <span>第24回日本サッカーリーグ1部</span>
          <span>JSL1部</span>
        </h1>

        <div class="league-profile">
          <p>参加チーム数：{standings.length}</p>
        </div>
      </header>

      <section class="archive-section">
        <h2>最終順位表</h2>

        <div class="table-scroll">
          <table class="standings-table">
            <thead>
              <tr>
                <th class="rank-column" scope="col">順位</th>
                <th class="team-column" scope="col">チーム</th>
                <th class="stat-column" scope="col">勝点</th>
                <th class="stat-column" scope="col">勝</th>
                <th class="stat-column" scope="col">分</th>
                <th class="stat-column" scope="col">敗</th>
                <th class="stat-column" scope="col">得点</th>
                <th class="stat-column" scope="col">失点</th>
                <th class="difference-column" scope="col">得失点差</th>
              </tr>
            </thead>

            <tbody>
              {standings.map((item) => (
                <tr>
                  <td class="rank-cell">
                    <span class="rank-content">
                      {isRelegated(item.rank) && (
                        <span
                          class="relegation-arrow"
                          aria-label="JSL2部降格"
                          title="JSL2部降格"
                        >▼</span>
                      )}
                      <span>{show(item.rank)}</span>
                    </span>
                  </td>
                  <td class="team-name">
                    <a href={item.url}>{item.name}</a>
                  </td>
                  <td class="points-cell">{show(item.points)}</td>
                  <td class="number">{show(item.wins)}</td>
                  <td class="number">{show(item.draws)}</td>
                  <td class="number">{show(item.losses)}</td>
                  <td class="number">{show(item.goalsFor)}</td>
                  <td class="number">{show(item.goalsAgainst)}</td>
                  <td class="number">{showGoalDifference(item.goalDifference)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="table-note">
          <span class="relegation-arrow" aria-hidden="true">▼</span>
          JSL2部降格
        </p>
      </section>
    </main>
  </body>
</html>

<style>
