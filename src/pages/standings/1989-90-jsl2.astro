---
import { team as mitsubishi } from "../../data/teams/mitsubishi-heavy-industries-89-90.js";
import { team as toyota } from "../../data/teams/toyota-89-90.js";
import { team as mazda } from "../../data/teams/mazda-soccer-club-89-90.js";
import { team as kyoto } from "../../data/teams/kyoto-shiko-club-89-90.js";
import { team as fujitsu } from "../../data/teams/fujitsu-89-90.js";
import { team as sumitomo } from "../../data/teams/sumitomo-metal-industries-89-90.js";
import { team as tanabe } from "../../data/teams/tanabe-seiyaku-89-90.js";
import { team as kawasaki } from "../../data/teams/kawasaki-steel-89-90.js";
import { team as ntt } from "../../data/teams/ntt-kanto-89-90.js";
import { team as cosmo } from "../../data/teams/cosmo-oil-89-90.js";
import { team as toho } from "../../data/teams/toho-titanium-89-90.js";
import { team as kofu } from "../../data/teams/kofu-soccer-club-89-90.js";
import { team as shinNippon } from "../../data/teams/shin-nippon-steel-89-90.js";
import { team as osaka } from "../../data/teams/osaka-gas-89-90.js";
import { team as mazdaAuto } from "../../data/teams/mazda-auto-hiroshima-89-90.js";
import { team as teijin } from "../../data/teams/teijin-89-90.js";

const teams = [
  { data: mitsubishi, url: "/teams/mitsubishi-heavy-industries-89-90" },
  { data: toyota, url: "/teams/toyota-89-90" },
  { data: mazda, url: "/teams/mazda-soccer-club-89-90" },
  { data: kyoto, url: "/teams/kyoto-shiko-club-89-90" },
  { data: fujitsu, url: "/teams/fujitsu-89-90" },
  { data: sumitomo, url: "/teams/sumitomo-metal-industries-89-90" },
  { data: tanabe, url: "/teams/tanabe-seiyaku-89-90" },
  { data: kawasaki, url: "/teams/kawasaki-steel-89-90" },
  { data: ntt, url: "/teams/ntt-kanto-89-90" },
  { data: cosmo, url: "/teams/cosmo-oil-89-90" },
  { data: toho, url: "/teams/toho-titanium-89-90" },
  { data: kofu, url: "/teams/kofu-soccer-club-89-90" },
  { data: shinNippon, url: "/teams/shin-nippon-steel-89-90" },
  { data: osaka, url: "/teams/osaka-gas-89-90" },
  { data: mazdaAuto, url: "/teams/mazda-auto-hiroshima-89-90" },
  { data: teijin, url: "/teams/teijin-89-90" },
];

const standings = teams
  .map(({ data, url }) => ({
    name: data.name,
    url,
    ...data.results.league,
  }))
  .sort((a, b) => a.rank - b.rank);

const show = (value) => {
  if (value === null || value === undefined) return "";
  return value;
};

const showGoalDifference = (value) => {
  if (value === null || value === undefined || value === "") return "";
  return Number(value) > 0 ? `+${value}` : value;
};

const isPromoted = (rank) => Number(rank) === 1 || Number(rank) === 2;
const isRelegated = (rank) => Number(rank) === 15 || Number(rank) === 16;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>89/90 第18回日本サッカーリーグ2部 JSL2部 順位表 | 日本クラブサッカーアーカイブ</title>
  </head>

  <body>
    <main>
      <p class="back">
        <a href="/standings/">← 順位表一覧へ戻る</a>
      </p>

      <nav class="season-navigation" aria-label="前後シーズン">
        <div class="season-nav-item previous">
          <span class="season-nav-label">← 前季</span>
          <a href="/standings/1988-89-jsl2">88/89 JSL2部</a>
        </div>

        <div class="season-nav-item next">
          <span class="season-nav-label">翌季 →</span>
          <span class="season-nav-unlinked">90/91 JSL2部</span>
        </div>
      </nav>

      <header class="league-header">
        <h1 class="league-heading">
          <span>89/90</span>
          <span>第18回日本サッカーリーグ2部</span>
          <span>JSL2部</span>
        </h1>

        <div class="league-profile">
          <p>参加チーム数：{standings.length}</p>
        </div>
      </header>

      <section class="archive-section">
        <h2>最終順位表</h2>

        <div class="table-scroll">
          <table class="standings-table">
            <thead>
              <tr>
                <th class="rank-column" scope="col">順位</th>
                <th class="team-column" scope="col">チーム</th>
                <th class="stat-column" scope="col">勝点</th>
                <th class="stat-column" scope="col">勝</th>
                <th class="stat-column" scope="col">分</th>
                <th class="stat-column" scope="col">敗</th>
                <th class="stat-column" scope="col">得点</th>
                <th class="stat-column" scope="col">失点</th>
                <th class="difference-column" scope="col">得失点差</th>
              </tr>
            </thead>

            <tbody>
              {standings.map((item) => (
                <tr>
                  <td class="rank-cell">
                    <span class="rank-content">
                      {isPromoted(item.rank) && (
                        <span
                          class="promotion-arrow"
                          aria-label="JSL1部昇格"
                          title="JSL1部昇格"
                        >▲</span>
                      )}
                      {isRelegated(item.rank) && (
                        <span
                          class="relegation-arrow"
                          aria-label="地域リーグ降格"
                          title="地域リーグ降格"
                        >▼</span>
                      )}
                      <span>{show(item.rank)}</span>
                    </span>
                  </td>
                  <td class="team-name">
                    <a href={item.url}>{item.name}</a>
                  </td>
                  <td class="points-cell">{show(item.points)}</td>
                  <td class="number">{show(item.wins)}</td>
                  <td class="number">{show(item.draws)}</td>
                  <td class="number">{show(item.losses)}</td>
                  <td class="number">{show(item.goalsFor)}</td>
                  <td class="number">{show(item.goalsAgainst)}</td>
                  <td class="number">{showGoalDifference(item.goalDifference)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="table-note">
          <span class="promotion-arrow" aria-hidden="true">▲</span>
          JSL1部昇格
          <span class="relegation-arrow" aria-hidden="true">▼</span>
          地域リーグ降格
        </p>
      </section>
    </main>
  </body>
</html>

<style>
