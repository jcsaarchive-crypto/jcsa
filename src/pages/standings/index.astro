---
import SiteHeader from "../../components/SiteHeader.astro";

// 公開済みの順位表だけを登録する。未完成ページのURLは追加しない。
const competitions = [
  {
    key: "JSL1",
    label: "JSL1部",
    category: "national",
    seasons: [
      { label: "88/89", href: "/standings/1988-89-jsl1" },
      { label: "89/90", href: "/standings/1989-90-jsl1" },
    ],
  },
  {
    key: "JSL2",
    label: "JSL2部",
    category: "national",
    seasons: [
      { label: "88/89", href: "/standings/1988-89-jsl2" },
      { label: "89/90", href: "/standings/1989-90-jsl2" },
    ],
  },
  {
    key: "HOKKAIDO",
    label: "北海道",
    category: "regional",
    seasons: [
      { label: "1991", competitionLabel: "北海道サッカーリーグ１部", href: "/standings/1991-hokkaido1" },
    ],
  },
  { key: "TOHOKU", label: "東北", category: "regional", seasons: [] },
  { key: "KANTO", label: "関東", category: "regional", seasons: [] },
  { key: "HOKUSHINETSU", label: "北信越", category: "regional", seasons: [] },
  { key: "TOKAI", label: "東海", category: "regional", seasons: [] },
  { key: "KANSAI", label: "関西", category: "regional", seasons: [] },
  { key: "CHUGOKU", label: "中国", category: "regional", seasons: [] },
  { key: "SHIKOKU", label: "四国", category: "regional", seasons: [] },
  { key: "KYUSHU", label: "九州", category: "regional", seasons: [] },
];

const national = competitions.filter((item) => item.category === "national");
const regional = competitions.filter((item) => item.category === "regional");
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="日本クラブサッカーアーカイブのシーズン別リーグ順位表一覧。大会・地域を選び、公開済みのシーズン順位表を探せます。" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>シーズン順位表から探す｜日本クラブサッカーアーカイブ</title>
  </head>
  <body>
    <SiteHeader currentPath="/standings/" />

    <main>
      <nav class="breadcrumb" aria-label="現在地">
        <a href="/">ホーム</a><span>›</span><span>シーズン順位表</span>
      </nav>

      <div class="intro">
        <p class="kicker">LEAGUE STANDINGS</p>
        <h1>シーズン順位表から探す</h1>
        <p>大会・地域を押すと、公開済みシーズンが小窓で開きます。シーズンを選ぶと順位表へ進みます。</p>
      </div>

      <nav class="archive-index" aria-label="大会・地域別順位表目次">
        <h2>大会・地域から探す</h2>
        <p class="index-note">大会・地域を選び、開いた小窓からシーズンを選択してください。</p>

        <h3>全国リーグ</h3>
        <div class="index-grid national-grid">
          {national.map((item) =>
            item.seasons.length ? (
              <details class="index-dropdown">
                <summary class="index-item">
                  {item.label}<span class="index-chevron" aria-hidden="true">⌄</span>
                </summary>
                <div class="index-subitems">
                  {item.seasons.map((season) => (
                    <a class="index-subitem" href={season.href}>
                      <span>{item.label}　{season.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <span class="index-item index-disabled" aria-disabled="true">{item.label}</span>
            )
          )}
        </div>

        <h3>地域リーグ・都道府県リーグ</h3>
        <div class="index-grid regional-grid">
          {regional.map((item) =>
            item.seasons.length ? (
              <details class="index-dropdown">
                <summary class="index-item">
                  {item.label}<span class="index-chevron" aria-hidden="true">⌄</span>
                </summary>
                <div class="index-subitems">
                  {item.seasons.map((season) => (
                    <a class="index-subitem" href={season.href}>
                      <span>{season.competitionLabel ?? item.label}　{season.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <span class="index-item index-disabled" aria-disabled="true">{item.label}</span>
            )
          )}
        </div>
        <p class="index-note bottom-note">未収録の地域は選択できません。</p>
      </nav>

      <p class="note">※ 順位表は公開済みの年度・大会から順次追加します。</p>
      <a class="back" href="/">← トップへ戻る</a>
    </main>

    <footer>
      <div><strong>日本クラブサッカーアーカイブ</strong><small>Japan Club Soccer Archive</small></div>
      <span>JCSA</span>
    </footer>

    <script>
      const dropdowns = document.querySelectorAll<HTMLDetailsElement>(".index-dropdown");

      dropdowns.forEach((dropdown) => {
        let closeTimer: ReturnType<typeof setTimeout> | undefined;
        const cancelClose = () => {
          if (closeTimer !== undefined) {
            clearTimeout(closeTimer);
            closeTimer = undefined;
          }
        };
        dropdown.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "mouse") cancelClose();
        });
        dropdown.addEventListener("pointerleave", (event) => {
          if (event.pointerType !== "mouse") return;
          cancelClose();
          closeTimer = setTimeout(() => {
            dropdown.open = false;
            closeTimer = undefined;
          }, 180);
        });
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) cancelClose();
        });
      });
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          dropdowns.forEach((dropdown) => (dropdown.open = false));
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f4f5f3; color: #202522; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP", sans-serif; }
  :global(a) { color: inherit; }

  main { width: min(1180px, calc(100% - 40px)); margin: auto; padding: 34px 0 100px; }
  .breadcrumb { display: flex; gap: 10px; align-items: center; font-size: 12px; color: #68716b; }
  .breadcrumb a { text-decoration: none; }
  .intro { margin: 62px 0 45px; }
  .kicker { color: #68716b; font-size: 11px; font-weight: 800; letter-spacing: .15em; }
  h1 { margin: 9px 0 18px; font-size: clamp(28px, 4vw, 40px); }
  .intro > p:last-child { color: #68716b; font-size: 14px; line-height: 1.9; }

  /* 大会・地域をすっきり並べる。小窓は開いた時だけ表示。 */
  .archive-index { max-width: 760px; }
  .archive-index h2 { margin: 0 0 8px; font-size: 20px; }
  .archive-index h3 { margin: 34px 0 12px; font-size: 14px; font-weight: 700; }
  .index-note { margin: 8px 0; color: #68716b; font-size: 12px; line-height: 1.7; }
  .bottom-note { margin-top: 14px; }
  .index-grid { display: grid; gap: 10px; }
  .national-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .regional-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .index-dropdown { position: relative; min-width: 0; }
  .index-item {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    min-height: 48px; padding: 12px 14px;
    background: #fff; border: 1px solid #d8deda; border-radius: 6px;
    color: #202522; font-size: 14px; font-weight: 700;
  }
  .index-dropdown summary { cursor: pointer; list-style: none; user-select: none; }
  .index-dropdown summary::-webkit-details-marker { display: none; }
  .index-dropdown summary:hover, .index-dropdown[open] > summary { background: #edf2ee; border-color: #aab8ae; }
  .index-dropdown[open] { z-index: 20; }
  .index-chevron { color: #68716b; font-size: 17px; font-weight: 400; line-height: 1; transition: transform .18s ease; }
  .index-dropdown[open] > summary .index-chevron { transform: rotate(180deg); }
  .index-subitems {
    position: absolute; top: calc(100% + 5px); left: 0; z-index: 30;
    width: max(100%, 220px); max-width: min(340px, calc(100vw - 32px));
    max-height: 320px; overflow-y: auto; padding: 5px;
    background: #fff; border: 1px solid #d8deda; border-radius: 6px;
    box-shadow: 0 8px 20px rgba(24, 38, 28, .12);
  }
  .index-subitem {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 11px 10px; border-radius: 4px;
    color: #202522; font-size: 13px; font-weight: 600; text-decoration: none;
  }
  .index-subitem + .index-subitem { border-top: 1px solid #eef1ee; }
  .index-subitem:hover { background: #edf2ee; }
  .index-subitem span:last-child { flex-shrink: 0; color: #7b8980; }
  .index-disabled { background: #ecefec; color: #969f99; font-weight: 500; }
  .index-dropdown summary:focus-visible, .index-subitem:focus-visible { outline: 2px solid #476d53; outline-offset: 2px; }

  .note { margin: 26px 0 35px; color: #68716b; font-size: 12px; }
  .back { font-size: 13px; font-weight: 700; text-decoration: none; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 150px; padding: 35px max(20px, calc((100% - 1280px) / 2)); background: #202522; color: #fff; }
  footer strong { font-size: 14px; }
  footer small { display: block; margin-top: 4px; }
  footer small, footer > span { color: #aeb6b0; font-size: 10px; }

  @media (max-width: 700px) {
    main { width: calc(100% - 24px); }
    .intro { margin-top: 45px; }
    .archive-index { max-width: none; }
    .regional-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .index-item { font-size: 13px; padding: 11px 12px; }
  }
</style>
