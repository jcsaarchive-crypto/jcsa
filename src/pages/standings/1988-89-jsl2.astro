
---
import { team as toshiba } from "../../data/teams/toshiba-88-89.js";
import { team as hitachi } from "../../data/teams/hitachi-88-89.js";
import { team as tanabe } from "../../data/teams/tanabe-seiyaku-88-89.js";
import { team as fujitsu } from "../../data/teams/fujitsu-88-89.js";
import { team as mazda } from "../../data/teams/mazda-soccer-club-88-89.js";
import { team as toyota } from "../../data/teams/toyota-88-89.js";
import { team as nttKanto } from "../../data/teams/ntt-kanto-88-89.js";
import { team as osakaGas } from "../../data/teams/osaka-gas-88-89.js";
import { team as kofu } from "../../data/teams/kofu-soccer-club-88-89.js";
import { team as shinNippon } from "../../data/teams/shin-nippon-steel-88-89.js";
import { team as cosmo } from "../../data/teams/cosmo-oil-88-89.js";
import { team as kawasaki } from "../../data/teams/kawasaki-steel-88-89.js";
import { team as teijin } from "../../data/teams/teijin-88-89.js";
import { team as toho } from "../../data/teams/toho-titanium-88-89.js";
import { team as nttKansai } from "../../data/teams/ntt-kansai-88-89.js";
import { team as fujieda } from "../../data/teams/fujieda-shiyakusho-88-89.js";

const teams = [
  { data: toshiba, slug: "toshiba-88-89" },
  { data: hitachi, slug: "hitachi-88-89" },
  { data: tanabe, slug: "tanabe-seiyaku-88-89" },
  { data: fujitsu, slug: "fujitsu-88-89" },
  { data: mazda, slug: "mazda-soccer-club-88-89" },
  { data: toyota, slug: "toyota-88-89" },
  { data: nttKanto, slug: "ntt-kanto-88-89" },
  { data: osakaGas, slug: "osaka-gas-88-89" },
  { data: kofu, slug: "kofu-soccer-club-88-89" },
  { data: shinNippon, slug: "shin-nippon-steel-88-89" },
  { data: cosmo, slug: "cosmo-oil-88-89" },
  { data: kawasaki, slug: "kawasaki-steel-88-89" },
  { data: teijin, slug: "teijin-88-89" },
  { data: toho, slug: "toho-titanium-88-89" },
  { data: nttKansai, slug: "ntt-kansai-88-89" },
  { data: fujieda, slug: "fujieda-shiyakusho-88-89" },
];

const statKeys = [
  "points",
  "wins",
  "draws",
  "losses",
  "goalsFor",
  "goalsAgainst",
];

const getNumber = (value, teamName, stageName, key) => {
  if (
    value === null ||
    value === undefined ||
    value === "" ||
    !Number.isFinite(Number(value))
  ) {
    throw new Error(
      `${teamName}: ${stageName} の ${key} を確認してください。`
    );
  }

  return Number(value);
};

const standings = teams
  .map(({ data, slug }) => {
    const league = data.results?.league;
    const stages = league?.stages;

    if (!Array.isArray(stages) || stages.length !== 2) {
      throw new Error(
        `${data.name}: 前期・後期の成績が2件揃っていません。`
      );
    }

    const upperStage = stages.find(
      (stage) => stage.name === "後期上位リーグ"
    );

    const finalRank = upperStage
      ? upperStage.rank
      : league?.overall?.rank;

    if (
      finalRank === null ||
      finalRank === undefined ||
      finalRank === "" ||
      !Number.isInteger(Number(finalRank)) ||
      Number(finalRank) < 1 ||
      Number(finalRank) > 16
    ) {
      throw new Error(
        `${data.name}: 最終順位をJSから取得できません。`
      );
    }

    const totals = {};

    for (const key of statKeys) {
      totals[key] = stages.reduce(
        (sum, stage) =>
          sum + getNumber(
            stage[key],
            data.name,
            stage.name,
            key
          ),
        0
      );
    }

    const goalDifference = stages.reduce(
      (sum, stage) => {
        const value = stage.goalDifference;

        if (
          value !== null &&
          value !== undefined &&
          value !== ""
        ) {
          return sum + getNumber(
            value,
            data.name,
            stage.name,
            "goalDifference"
          );
        }

        const goalsFor = getNumber(
          stage.goalsFor,
          data.name,
          stage.name,
          "goalsFor"
        );

        const goalsAgainst = getNumber(
          stage.goalsAgainst,
          data.name,
          stage.name,
          "goalsAgainst"
        );

        return sum + (goalsFor - goalsAgainst);
      },
      0
    );

    return {
      name: data.name,
      url: `/teams/${slug}`,
      rank: Number(finalRank),
      ...totals,
      goalDifference,
    };
  })
  .sort((a, b) => a.rank - b.rank);

if (standings.length !== 16) {
  throw new Error("JSL2部の参加チーム数が16ではありません。");
}

const ranks = standings.map((item) => item.rank);

if (new Set(ranks).size !== 16) {
  throw new Error("JSL2部の最終順位に重複があります。");
}

for (let rank = 1; rank <= 16; rank++) {
  if (!ranks.includes(rank)) {
    throw new Error(`JSL2部の最終順位 ${rank} 位がありません。`);
  }
}

const show = (value) => {
  if (value === null || value === undefined) return "";
  return value;
};

const showGoalDifference = (value) => {
  if (value === null || value === undefined || value === "") return "";
  return Number(value) > 0 ? `+${value}` : value;
};

const isPromoted = (rank) =>
  Number(rank) === 1 || Number(rank) === 2;

const isRelegated = (rank) =>
  Number(rank) === 15 || Number(rank) === 16;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>1988/89 第17回日本サッカーリーグ2部 JSL2部 順位表 | 日本クラブサッカーアーカイブ</title>
  </head>

  <body>
    <main>
      <p class="back">
        <a href="/">← トップへ戻る</a>
      </p>

      <header class="league-header">
        <h1 class="league-heading">
          <span>1988/89</span>
          <span>第17回日本サッカーリーグ2部</span>
          <span>JSL2部</span>
        </h1>

        <div class="league-profile">
          <p>参加チーム数：{standings.length}</p>
        </div>
      </header>

      <section class="archive-section">
        <h2>最終順位表</h2>

        <div class="table-scroll">
          <table class="standings-table">
            <thead>
              <tr>
                <th class="rank-column" scope="col">順位</th>
                <th class="team-column" scope="col">チーム</th>
                <th class="stat-column" scope="col">勝点</th>
                <th class="stat-column" scope="col">勝</th>
                <th class="stat-column" scope="col">分</th>
                <th class="stat-column" scope="col">敗</th>
                <th class="stat-column" scope="col">得点</th>
                <th class="stat-column" scope="col">失点</th>
                <th class="difference-column" scope="col">得失点差</th>
              </tr>
            </thead>

            <tbody>
              {standings.map((item) => (
                <tr>
                  <td class="rank-cell">
                    <span class="rank-content">
                      {isPromoted(item.rank) && (
                        <span
                          class="promotion-arrow"
                          aria-label="JSL1部昇格"
                          title="JSL1部昇格"
                        >▲</span>
                      )}
                      {isRelegated(item.rank) && (
                        <span
                          class="relegation-arrow"
                          aria-label="地域リーグ降格"
                          title="地域リーグ降格"
                        >▼</span>
                      )}
                      <span>{show(item.rank)}</span>
                    </span>
                  </td>
                  <td class="team-name">
                    <a href={item.url}>{item.name}</a>
                  </td>
                  <td class="points-cell">{show(item.points)}</td>
                  <td class="number">{show(item.wins)}</td>
                  <td class="number">{show(item.draws)}</td>
                  <td class="number">{show(item.losses)}</td>
                  <td class="number">{show(item.goalsFor)}</td>
                  <td class="number">{show(item.goalsAgainst)}</td>
                  <td class="number">{showGoalDifference(item.goalDifference)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="table-notes">
          <p class="table-note">
            <span class="promotion-arrow" aria-hidden="true">▲</span>
            JSL1部昇格
          </p>
          <p class="table-note">
            <span class="relegation-arrow" aria-hidden="true">▼</span>
            地域リーグ降格
          </p>
        </div>

        <p class="competition-note">
          ※成績は前期・後期リーグの合計。下位8チームの最終順位は、東西同順位チームによる順位決定戦を経て決定された。順位決定戦の成績は通算成績に含まない。
        </p>
      </section>
    </main>
  </body>
</html>

<style>
