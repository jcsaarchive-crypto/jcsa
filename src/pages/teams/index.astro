  { name: "NSC八幡", kana: "えぬえすしーやはた", aliases: ["NSC八幡", "新日鐵八幡", "新日本製鐵", "八幡製鐵"] },
  { name: "鹿島アントラーズ", kana: "かしまあんとらーず", aliases: ["鹿島アントラーズ", "住友金属工業"] },
  { name: "横浜フリューゲルス", kana: "よこはまふりゅーげるす", aliases: ["横浜フリューゲルス", "全日空サッカークラブ", "全日空横浜サッカークラブ", "横浜トライスターサッカークラブ"] },
  { name: "田辺三菱製薬", kana: "たなべみつびしせいやく", aliases: ["田辺三菱製薬", "田辺製薬"] },
  { name: "テイジン", kana: "ていじん", aliases: ["テイジン", "帝人", "帝人松山"] },
  { name: "トヨタ自動車", kana: "とよたじどうしゃ", aliases: ["トヨタ自動車", "トヨタ自動車工業"] },
  { name: "横浜F・マリノス", kana: "よこはまえふまりのす", aliases: ["横浜F・マリノス", "横浜マリノス", "日産F.C.横浜マリノス", "日産自動車"] },
  { name: "柏レイソル", kana: "かしわれいそる", aliases: ["柏レイソル", "日立FC柏レイソル", "日立フットボールクラブ", "日立製作所", "日立製作所本社"] },
  { name: "湘南ベルマーレ", kana: "しょうなんべるまーれ", aliases: ["湘南ベルマーレ", "ベルマーレ平塚", "フジタサッカークラブ", "フジタ工業クラブ", "藤和不動産"] },
  { name: "ジェフユナイテッド千葉", kana: "じぇふゆないてっどちば", aliases: ["ジェフユナイテッド千葉", "ジェフユナイテッド市原", "東日本JR古河SC（ジェフユナイテッド）", "東日本JR古河SC", "古河電気工業"] },
  { name: "北海道コンサドーレ札幌", kana: "ほっかいどうこんさどーれさっぽろ", aliases: ["北海道コンサドーレ札幌", "コンサドーレ札幌", "東芝", "東芝堀川町"] },
  { name: "Honda FC", kana: "ほんだえふしー", aliases: ["Honda FC", "本田技研工業"] },
  { name: "ガンバ大阪", kana: "がんばおおさか", aliases: ["ガンバ大阪", "パナソニックガンバ大阪", "松下電器産業"] },
  { name: "アンフィニ広島", kana: "あんふぃにひろしま", aliases: ["アンフィニ広島", "マツダオート広島"] },
  { name: "サンフレッチェ広島", kana: "さんふれっちぇひろしま", aliases: ["サンフレッチェ広島", "サンフレッチェ広島F.C", "マツダサッカークラブ", "マツダスポーツクラブ", "マツダスポーツクラブ東洋工業", "東洋工業"] },
  { name: "浦和レッズ", kana: "うらわれっず", aliases: ["浦和レッズ", "浦和レッドダイヤモンズ", "三菱浦和FC（レッドダイヤモンズ）", "三菱自動車工業", "三菱重工業"] },
  { name: "ジュビロ磐田", kana: "じゅびろいわた", aliases: ["ジュビロ磐田", "ヤマハFCジュビロ磐田", "ヤマハフットボールクラブ", "ヤマハ発動機"] },
  { name: "セレッソ大阪", kana: "せれっそおおさか", aliases: ["セレッソ大阪", "ヤンマーディーゼル"] },
  { name: "東京ヴェルディ", kana: "とうきょうゔぇるでぃ", aliases: ["東京ヴェルディ", "東京ヴェルディ1969", "ヴェルディ川崎", "読売日本SC（読売ヴェルディ）", "読売サッカークラブ"] },
];

const seasonSort = (season) => {
  const m = season.match(/^(\d{2})\/(\d{2})$/);
  if (m) return 1900 + Number(m[1]) + 0.5;
  return Number(season) || 0;
};
const toHiragana = (value) => value.replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 96));
const kanaGroup = (kana) => {
  const first = (toHiragana(kana)[0] ?? "").replace("ゔ", "う");
  const rows = ["あいうえお", "かきくけこがぎぐげご", "さしすせそざじずぜぞ", "たちつてとだぢづでど", "なにぬねの", "はひふへほばびぶべぼぱぴぷぺぽ", "まみむめも", "やゆよ", "らりるれろ", "わをん"];
  const headings = ["あ", "か", "さ", "た", "な", "は", "ま", "や", "ら", "わ"];
  return headings[rows.findIndex((row) => row.includes(first))] ?? "その他";
};
// シーズン限定の表記ゆれ。見出しの歴代名称には追加しない。
const recordNameToClub = { "東芝 / コンサドーレ札幌": "北海道コンサドーレ札幌" };
const definedNames = new Set(clubDefinitions.flatMap((club) => club.aliases));
const unmatchedNames = [...new Set(records.map((record) => record.name))].filter((name) => !definedNames.has(name) && !recordNameToClub[name]);
const independentKana = {"大阪ガス": "おおさかがす", "東邦チタニウム": "とうほうちたにうむ", "藤枝市役所": "ふじえだしやくしょ"};
const independentClubs = unmatchedNames.map((name) => ({ name, kana: independentKana[name] ?? name, aliases: [name] }));
const allDefinitions = [...clubDefinitions, ...independentClubs];
const clubs = allDefinitions.map((club) => ({
  ...club,
  entries: records.filter((record) => (club.aliases.includes(record.name) || recordNameToClub[record.name] === club.name)).sort((a, b) => seasonSort(a.season) - seasonSort(b.season) || a.name.localeCompare(b.name, "ja")),
  group: kanaGroup(club.kana),
})).filter((club) => club.entries.length).sort((a, b) => a.kana.localeCompare(b.kana, "ja"));
const headings = ["あ", "か", "さ", "た", "な", "は", "ま", "や", "ら", "わ", "その他"];
const indexed = headings.map((heading) => ({ heading, clubs: clubs.filter((club) => club.group === heading) })).filter((section) => section.clubs.length);
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>チームから探す | 日本クラブサッカーアーカイブ</title>
    <meta name="description" content="日本クラブサッカーアーカイブに収録されたチームを五十音順から探し、歴代名称とシーズン別の記録をたどれます。" />
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main>
      <p class="back"><a href="/">← トップへ戻る</a></p>
      <p class="eyebrow">CLUB INDEX</p>
      <h1>チームから探す</h1>
      <p class="intro">チーム名を選ぶと、収録済みのシーズンが開きます。各シーズンから当時のチームページへ進めます。</p>
      <p class="notice">確認済みの28クラブ系譜を統合。旧名称からも探せます。</p>
      <div class="search-area">
        <label for="club-search">チーム名を検索（旧名称も対象）</label>
        <input id="club-search" type="search" placeholder="例：東芝、古河電気工業、日立製作所" autocomplete="off" />
        <p id="search-count" aria-live="polite"></p>
      </div>
      <nav class="kana-nav" aria-label="五十音目次">
        {headings.map((heading) => indexed.some((s) => s.heading === heading) ? <a href={`#kana-${heading}`}>{heading}</a> : <span aria-disabled="true">{heading}</span>)}
      </nav>
      <div class="index-sections">
        {indexed.map((section) => (
          <section class="kana-section" id={`kana-${section.heading}`}>
            <h2>{section.heading}行</h2>
            <div class="club-list">
              {section.clubs.map((club) => (
                <details class="club" data-search={`${club.name} ${club.aliases.join(" ")} ${club.kana} ${club.entries.map((entry) => entry.name).join(" ")}`}>
                  <summary>
                    <span class="club-title">{club.aliases.join(" ／ ")}</span>
                    <span class="club-meta">{club.entries.length}シーズン <span class="chevron">⌄</span></span>
                  </summary>
                  <div class="club-body">
                    
                    <div class="season-links">
                      {club.entries.map((entry) => (
                        <a href={entry.url} class="season-link">
                          <span class="season">{entry.season}</span>
                          <span class="historical-name">{entry.name}</span>
                          <span class="competition">{entry.competition}{entry.rank != null ? `・${entry.rank}位` : ""}</span>
                          <span class="arrow" aria-hidden="true">→</span>
                        </a>
                      ))}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>
    <script>
      const input = document.querySelector<HTMLInputElement>("#club-search");
      const count = document.querySelector<HTMLElement>("#search-count");
      const items = [...document.querySelectorAll<HTMLElement>("details.club")];
      const sections = [...document.querySelectorAll<HTMLElement>("section.kana-section")];
      input?.addEventListener("input", () => {
        const query = (input.value ?? "").trim().toLocaleLowerCase("ja").normalize("NFKC");
        let visible = 0;
        items.forEach((item) => {
          const text = (item.dataset.search ?? "").toLocaleLowerCase("ja").normalize("NFKC");
          item.hidden = Boolean(query) && !text.includes(query);
          if (!item.hidden) visible++;
        });
        sections.forEach((section) => {
          section.hidden = ![...section.querySelectorAll("details.club")].some((item) => !item.hidden);
        });
        if (count) count.textContent = query ? `${visible}クラブが見つかりました` : "";
      });
    </script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f4f5f3; color: #202522; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP", sans-serif; }
  main { width: min(1000px, calc(100% - 40px)); margin: 0 auto; padding: 50px 0 90px; }
