  .kana-nav a:hover { background: #edf2ee; border-color: #9eaaa1; }
  .kana-nav span { color: #a5ada7; background: #f4f5f3; }
  .kana-section { margin-top: 46px; scroll-margin-top: 24px; }
  .kana-section h2 { font-size: 22px; margin: 0 0 18px; padding-bottom: 14px; border-bottom: 2px solid #bfc6c1; }
  .club-list { display: grid; gap: 10px; }
  .club { background: #fff; border: 1px solid #cfd5d0; border-radius: 7px; min-width: 0; }
  .club[open] { border-color: #9eaaa1; }
  .club summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 17px 20px; cursor: pointer; }
  .club summary::-webkit-details-marker { display: none; }
  .club summary:hover, .club[open] summary { background: #f3f6f3; }
  .club-title { font-size: 16px; font-weight: 700; }
  .club-meta { flex-shrink: 0; color: #68716b; font-size: 12px; }
  .chevron { display: inline-block; font-size: 19px; margin-left: 8px; transition: transform .18s; }
  .club[open] .chevron { transform: rotate(180deg); }
  .club-body { padding: 0 20px 20px; }
  .aliases { margin: 4px 0 14px; color: #68716b; font-size: 12px; line-height: 1.8; }
  .season-links { border-top: 1px solid #e2e7e3; }
  .season-link { display: grid; grid-template-columns: 64px minmax(0, 1.1fr) minmax(0, 1.4fr) 16px; align-items: center; gap: 12px; padding: 13px 4px; border-bottom: 1px solid #e2e7e3; text-decoration: none; }
  .season-link:hover { background: #f3f6f3; }
  .season { color: #202522; font-weight: 700; font-size: 13px; }
  .historical-name { color: #2563eb; font-size: 14px; font-weight: 700; }
  .competition { color: #68716b; font-size: 12px; }
  .arrow { color: #2563eb; }
  summary:focus-visible, a:focus-visible { outline: 2px solid #476d53; outline-offset: 2px; }
  @media (max-width: 600px) {
    main { width: calc(100% - 24px); padding-top: 30px; }
    .back { margin-bottom: 35px; }
    .search-area { margin: 0 0 20px; }
   .search-area label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 700; }
   .search-area input { width: 100%; padding: 14px 16px; border: 1px solid #bfc6c1; border-radius: 6px; font: inherit; background: white; }
   #search-count { margin: 6px 0 0; font-size: 12px; color: #68716b; }
   [hidden] { display: none !important; }
   .kana-nav { padding: 12px; gap: 6px; }
    .kana-nav a, .kana-nav span { width: 42px; height: 40px; }
    .club summary { padding: 15px 13px; }
    .club-body { padding: 0 13px 14px; }
    .season-link { grid-template-columns: 54px minmax(0, 1fr) 16px; gap: 7px; }
    .competition { grid-column: 2; grid-row: 2; }
    .arrow { grid-column: 3; grid-row: 1 / span 2; }
