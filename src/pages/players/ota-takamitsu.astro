---
import { player } from "../../data/players/P004.js";
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{player.name} | 日本サッカーWEBデータベース</title>
  </head>

  <body>
    <main>
      <p class="back"><a href="/">← トップへ戻る</a></p>

      <header class="player-header">
        <p class="label">PLAYER</p>
        <h1>{player.name}</h1>
        <p class="name-en">{player.nameEn}</p>

        <div class="profile">
          <p>{player.position}</p>
          <p>{player.birth}－{player.death}</p>
          <p>{player.birthplace}</p>
          <p>{player.height}cm / {player.weight}kg</p>
          <p>{player.education}</p>
        </div>
      </header>

      <section class="archive-section">
        <h2>所属歴</h2>

        <div class="history-list">
          {player.history.map((item) => (
            <article class="history-item">
              <div class="season">{item.season}</div>
              <div>
                <h3>
  {item.teamUrl ? (
    <a href={item.teamUrl}>{item.team}</a>
  ) : (
    item.team
  )}
</h3>
                <p>{item.division}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Noto Sans JP", sans-serif;
  }

  main {
    width: min(1000px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 90px;
  }

  .back {
    margin: 0 0 55px;
    font-size: 14px;
  }

  .back a {
    color: #68716b;
    text-decoration: none;
  }

  .label {
    margin: 0 0 8px;
    color: #68716b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.2;
  }

  .name-en {
    margin: 8px 0 0;
    color: #68716b;
    font-size: 15px;
  }

  .profile {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #cfd5d0;
  }

  .profile p {
    margin: 7px 0;
  }

  .archive-section {
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid #cfd5d0;
  }

  h2 {
    margin: 0 0 25px;
    font-size: 22px;
  }

  .history-list {
    border-top: 1px solid #cfd5d0;
  }

  .history-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 25px;
    padding: 20px 0;
    border-bottom: 1px solid #cfd5d0;
  }

  .season {
    color: #68716b;
    font-size: 14px;
    font-weight: 600;
  }

  h3 {
    margin: 0 0 5px;
    font-size: 18px;
  }

  .history-item p {
    margin: 0;
    color: #68716b;
    font-size: 14px;
  }

  @media (max-width: 600px) {
    main {
      width: calc(100% - 24px);
    }

    .history-item {
      grid-template-columns: 80px 1fr;
      gap: 15px;
    }
  }
</style>