---
import { playerPages } from "../../data/links.js";

const playerModules = import.meta.glob(
  "../../data/players/P*.js",
  { eager: true }
);

const players = Object.values(playerModules)
  .map((module) => module.player)
  .filter((player) => {
    return (
      player &&
      player.id &&
      player.name &&
      player.nameKana &&
      playerPages[player.id]
    );
  })
  .sort((a, b) =>
    a.nameKana.localeCompare(b.nameKana, "ja")
  );

const kanaGroups = [
  { key: "あ", label: "あ", chars: ["あ"] },
  { key: "い", label: "い", chars: ["い"] },
  { key: "う", label: "う", chars: ["う"] },
  { key: "え", label: "え", chars: ["え"] },
  { key: "お", label: "お", chars: ["お"] },

  { key: "か", label: "か", chars: ["か", "が"] },
  { key: "き", label: "き", chars: ["き", "ぎ"] },
  { key: "く", label: "く", chars: ["く", "ぐ"] },
  { key: "け", label: "け", chars: ["け", "げ"] },
  { key: "こ", label: "こ", chars: ["こ", "ご"] },

  { key: "さ", label: "さ", chars: ["さ", "ざ"] },
  { key: "し", label: "し", chars: ["し", "じ"] },
  { key: "す", label: "す", chars: ["す", "ず"] },
  { key: "せ", label: "せ", chars: ["せ", "ぜ"] },
  { key: "そ", label: "そ", chars: ["そ", "ぞ"] },

  { key: "た", label: "た", chars: ["た", "だ"] },
  { key: "ち", label: "ち", chars: ["ち", "ぢ"] },
  { key: "つ", label: "つ", chars: ["つ", "づ"] },
  { key: "て", label: "て", chars: ["て", "で"] },
  { key: "と", label: "と", chars: ["と", "ど"] },

  { key: "な", label: "な", chars: ["な"] },
  { key: "に", label: "に", chars: ["に"] },
  { key: "ぬ", label: "ぬ", chars: ["ぬ"] },
  { key: "ね", label: "ね", chars: ["ね"] },
  { key: "の", label: "の", chars: ["の"] },

  { key: "は", label: "は", chars: ["は", "ば", "ぱ"] },
  { key: "ひ", label: "ひ", chars: ["ひ", "び", "ぴ"] },
  { key: "ふ", label: "ふ", chars: ["ふ", "ぶ", "ぷ"] },
  { key: "へ", label: "へ", chars: ["へ", "べ", "ぺ"] },
  { key: "ほ", label: "ほ", chars: ["ほ", "ぼ", "ぽ"] },

  { key: "ま", label: "ま", chars: ["ま"] },
  { key: "み", label: "み", chars: ["み"] },
  { key: "む", label: "む", chars: ["む"] },
  { key: "め", label: "め", chars: ["め"] },
  { key: "も", label: "も", chars: ["も"] },

  { key: "や", label: "や", chars: ["や"] },
  { key: "ゆ", label: "ゆ", chars: ["ゆ"] },
  { key: "よ", label: "よ", chars: ["よ"] },

  { key: "ら", label: "ら", chars: ["ら"] },
  { key: "り", label: "り", chars: ["り"] },
  { key: "る", label: "る", chars: ["る"] },
  { key: "れ", label: "れ", chars: ["れ"] },
  { key: "ろ", label: "ろ", chars: ["ろ"] },

  { key: "わ", label: "わ", chars: ["わ"] },
  { key: "を", label: "を", chars: ["を"] },
  { key: "ん", label: "ん", chars: ["ん"] },
];

const groups = kanaGroups
  .map((group) => ({
    ...group,
    players: players.filter((player) =>
      group.chars.includes(player.nameKana.charAt(0))
    ),
  }))
  .filter((group) => group.players.length > 0);
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>選手索引 | 日本サッカーWEBデータベース</title>
  </head>

  <body>
    <main>
      <p class="back"><a href="/">← トップへ戻る</a></p>

      <p class="label">PLAYER INDEX</p>
      <h1>選手索引</h1>

      <p class="intro">
        個人ページを収録している選手を、五十音順から辿る。
      </p>

      <nav class="kana-nav" aria-label="五十音索引">
        {groups.map((group) => (
          <a href={`#${group.key}`}>{group.label}</a>
        ))}
      </nav>

      <section class="archive-section">
        {groups.map((group) => (
          <div class="kana-group" id={group.key}>
            <h2>{group.label}</h2>

            <div class="player-list">
              {group.players.map((player) => (
                <a
                  class="player-row"
                  href={playerPages[player.id]}
                >
                  <span class="player-name">
                    {player.name}
                  </span>

                  <span class="player-kana">
                    {player.nameKana}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Noto Sans JP",
      sans-serif;
  }

  main {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 90px;
  }

  .back {
    margin: 0 0 55px;
    font-size: 14px;
  }

  .back a {
    color: #68716b;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
  }

  .label {
    margin: 0 0 8px;
    color: #68716b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.2;
  }

  .intro {
    margin: 0;
    color: #68716b;
  }

  .kana-nav {
    display: grid;
    grid-template-columns: repeat(10, 46px);
    gap: 8px;
    margin-top: 42px;
  }

  .kana-nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 42px;
    background: #ffffff;
    border: 1px solid #cfd5d0;
    color: #202522;
    text-align: center;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
  }

  .kana-nav a:hover {
    background: #e7ebe8;
  }

  .archive-section {
    margin-top: 35px;
    padding-top: 25px;
    border-top: 1px solid #cfd5d0;
  }

  .kana-group {
    max-width: 900px;
    scroll-margin-top: 25px;
  }

  .kana-group + .kana-group {
    margin-top: 45px;
    padding-top: 30px;
    border-top: 1px solid #d9ddda;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 24px;
  }

  .player-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .player-row {
    display: grid;
    grid-template-columns: minmax(250px, 1fr) minmax(220px, 0.8fr);
    align-items: center;
    gap: 32px;
    width: 100%;
    min-height: 52px;
    padding: 13px 18px;
    background: #ffffff;
    border: 1px solid #cfd5d0;
    color: #202522;
    text-decoration: none;
  }

  .player-row:hover {
    background: #e7ebe8;
  }

  .player-name {
    min-width: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .player-kana {
    min-width: 0;
    color: #68716b;
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  @media (max-width: 700px) {
    main {
      width: calc(100% - 16px);
      padding-top: 40px;
    }

    .kana-nav {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 7px;
    }

    .kana-nav a {
      width: 100%;
      height: 42px;
      padding: 0;
    }

    .kana-group {
      max-width: none;
    }

    .player-row {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      gap: 12px;
      padding: 13px 12px;
    }

    .player-name {
      font-size: 16px;
      line-height: 1.45;
    }

    .player-kana {
      font-size: 11px;
      line-height: 1.45;
    }
  }

  @media (max-width: 420px) {
    .player-row {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.9fr);
      gap: 8px;
      padding: 12px 10px;
    }

    .player-name {
      font-size: 15px;
    }

    .player-kana {
      font-size: 10px;
    }
  }
</style>