    width: min(1000px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 90px;
  }

  .back {
    margin: 0 0 55px;
    font-size: 14px;
  }

  .back a {
    color: #68716b;
    text-decoration: none;
  }

