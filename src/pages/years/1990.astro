const seasonOrder = [
  "1990",
  "90/91",
  "1991",
  "91/92",
  "1992",
  "1993",
  "1994",
  "1995",
  "1996",
  "1997",
  "1998",
  "1999",
];

const competitionOrder = [
  "JSL1",
  "JSL2",

  "J",
  "J1",
  "J2",

  "OLD_JFL1",
  "OLD_JFL2",
  "OLD_JFL",
  "JFL",

  "HOKKAIDO",
  "TOHOKU",
  "KANTO",
  "HOKUSHINETSU",
  "TOKAI",
  "KANSAI",
  "CHUGOKU",
  "SHIKOKU",
  "KYUSHU",
];

const registeredSeasons = [
  ...new Set(teams.map((team) => team.season)),
];

const allSeasons = [
  ...seasonOrder.filter((season) =>
    registeredSeasons.includes(season)
  ),
  ...registeredSeasons.filter(
    (season) => !seasonOrder.includes(season)
  ),
];

const groupedSeasons = allSeasons
  .map((season) => {
    const seasonTeams = teams.filter(
      (team) => team.season === season
    );

    const competitionKeys = [
      ...new Set(
        seasonTeams.map((team) => team.competitionKey)
      ),
    ];

    const competitions = competitionKeys
      .sort((a, b) => {
        const aIndex = competitionOrder.indexOf(a);
        const bIndex = competitionOrder.indexOf(b);

        const aOrder =
          aIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : aIndex;

        const bOrder =
          bIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : bIndex;

        return aOrder - bOrder;
      })
      .map((competitionKey) => {
        const competitionTeams = seasonTeams
          .filter(
            (team) =>
              team.competitionKey === competitionKey
          )
          .sort((a, b) => {
            if (a.rank == null && b.rank == null) {
              return a.name.localeCompare(
                b.name,
                "ja"
              );
            }

            if (a.rank == null) return 1;
            if (b.rank == null) return -1;

            return a.rank - b.rank;
          });

        return {
          competitionKey,
          competition:
            competitionTeams[0]?.competition ?? "",
          teams: competitionTeams,
        };
      });

    return {
      season,
      competitions,
    };
  })
  .filter(
    (seasonGroup) =>
      seasonGroup.competitions.length > 0
  );

// 大会・地域目次。リンク先が存在するものだけクリック可能にする。
// 都府県リーグ追加時は、該当チームに regionKey（例: "KANTO"）を指定する。
const regionIndex = [
  { key: "HOKKAIDO", label: "北海道" },
  { key: "TOHOKU", label: "東北" },
  { key: "KANTO", label: "関東" },
  { key: "HOKUSHINETSU", label: "北信越" },
  { key: "TOKAI", label: "東海" },
  { key: "KANSAI", label: "関西" },
  { key: "CHUGOKU", label: "中国" },
  { key: "SHIKOKU", label: "四国" },
  { key: "KYUSHU", label: "九州" }
];

const leagueIndex = [
  { key: "JSL1", label: "JSL1部" },
  { key: "JSL2", label: "JSL2部" },
  { key: "J", keys: ["J", "J1"], label: "Jリーグ／J1" },
  { key: "J2", label: "J2" },
  { key: "OLD_JFL", keys: ["OLD_JFL", "OLD_JFL1"], label: "旧JFL／旧JFL1部" },
  { key: "OLD_JFL2", label: "旧JFL2部" },
  { key: "JFL", label: "JFL" },
];

const regionalKeys = regionIndex.map((region) => region.key);
const regionOf = (team) =>
  team.regionKey ||
  (regionalKeys.includes(team.competitionKey) ? team.competitionKey : null);

const firstCompetitionAnchor = (key) => {
  const first = groupedSeasons.find((group) =>
    group.competitions.some((competition) => competition.competitionKey === key)
  );
  return first ? `#competition-${key}-${first.season.replace(/[^0-9a-z]/gi, "-")}` : null;
};

const firstRegionAnchor = (key) => {
  const first = groupedSeasons.find((group) =>
    group.competitions.some((competition) =>
      competition.teams.some((team) => regionOf(team) === key)
    )
  );
  if (!first) return null;
  const competition = first.competitions.find((entry) =>
    entry.teams.some((team) => regionOf(team) === key)
  );
  return `#competition-${competition.competitionKey}-${first.season.replace(/[^0-9a-z]/gi, "-")}`;
};

---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <title>
      1990年代 | 日本サッカーWEBデータベース
    </title>
  </head>

  <body>
    <main>
      <p class="back">
        <a href="/">← トップへ戻る</a>
      </p>

      <p class="label">DECADE</p>

      <h1>1990年代</h1>

      <p class="intro">
        1990年代の日本サッカーを、シーズンとチームから辿る。
      </p>


      <nav class="archive-index" aria-label="大会・地域別目次">
        <h2>大会・地域から探す</h2>
        <p class="index-note">収録済みの大会・地域は、クリックすると最初の掲載箇所へ移動します。</p>
        <h3>全国リーグ</h3>
        <div class="index-grid">
          {leagueIndex.map((item) => {
            const href = (item.keys ?? [item.key])
              .map((key) => firstCompetitionAnchor(key))
              .find(Boolean) ?? null;
            return href ? (
              <a class="index-item" href={href}>{item.label} <span aria-hidden="true">↓</span></a>
            ) : (
              <span class="index-item index-disabled">{item.label}</span>
            );
          })}
        </div>
        <h3>地域リーグ・都道府県リーグ</h3>
        <div class="index-grid">
          {regionIndex.map((item) => {
            const href = firstRegionAnchor(item.key);
            return href ? (
              <a class="index-item" href={href}>{item.label} <span aria-hidden="true">↓</span></a>
            ) : (
              <span class="index-item index-disabled">{item.label}</span>
            );
          })}
        </div>
        <p class="index-note">都府県リーグは各地域に含めて整理します。未収録の項目にはリンクを設けていません。</p>
      </nav>

      <section class="archive-section">
        <h2>収録シーズン</h2>

        {
          groupedSeasons.map((seasonGroup) => (
            <div class="season-block">
              <div class="season-heading">
                {seasonGroup.season}
              </div>

              {
                seasonGroup.competitions.map(
                  (competitionGroup) => (
                    <div class="competition-group" id={`competition-${competitionGroup.competitionKey}-${seasonGroup.season.replace(/[^0-9a-z]/gi, "-")}`}>
                      <h3>
                        <span class="competition-name">
                          {
                            competitionGroup.competition
                          }
                        </span>

                        <span class="competition-season">
                          {seasonGroup.season}
                        </span>
                      </h3>

                      <div class="team-section">
                        <h4>収録チーム</h4>

                        <div class="team-list">
                          {
                            competitionGroup.teams.map(
                              (team) => (
                                <a href={team.url}>
                                  <span class="team-rank">
                                    {
                                      team.rank != null
                                        ? `${team.rank}位`
                                        : "—"
                                    }
                                  </span>

                                  <strong>
                                    {team.name}
                                  </strong>
                                </a>
                              )
                            )
                          }
                        </div>
                      </div>
                    </div>
                  )
                )
              }
            </div>
          ))
        }
      </section>
    </main>
  </body>
</html>

