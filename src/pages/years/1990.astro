const seasonOrder = [
  "1990",
  "90/91",
  "1991",
  "91/92",
  "1992",
  "1993",
  "1994",
  "1995",
  "1996",
  "1997",
  "1998",
  "1999",
];

const competitionOrder = [
  "JSL1",
  "JSL2",

  "J",
  "J1",
  "J2",

  "OLD_JFL1",
  "OLD_JFL2",
  "OLD_JFL",
  "JFL",

  "HOKKAIDO",
  "TOHOKU",
  "KANTO",
  "HOKUSHINETSU",
  "TOKAI",
  "KANSAI",
  "CHUGOKU",
  "SHIKOKU",
  "KYUSHU",
];

const registeredSeasons = [
  ...new Set(teams.map((team) => team.season)),
];

const allSeasons = [
  ...seasonOrder.filter((season) =>
    registeredSeasons.includes(season)
  ),
  ...registeredSeasons.filter(
    (season) => !seasonOrder.includes(season)
  ),
];

const groupedSeasons = allSeasons
  .map((season) => {
    const seasonTeams = teams.filter(
      (team) => team.season === season
    );

    const competitionKeys = [
      ...new Set(
        seasonTeams.map((team) => team.competitionKey)
      ),
    ];

    const competitions = competitionKeys
      .sort((a, b) => {
        const aIndex = competitionOrder.indexOf(a);
        const bIndex = competitionOrder.indexOf(b);

        const aOrder =
          aIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : aIndex;

        const bOrder =
          bIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : bIndex;

        return aOrder - bOrder;
      })
      .map((competitionKey) => {
        const competitionTeams = seasonTeams
          .filter(
            (team) =>
              team.competitionKey === competitionKey
          )
          .sort((a, b) => {
            if (a.rank == null && b.rank == null) {
              return a.name.localeCompare(
                b.name,
                "ja"
              );
            }

            if (a.rank == null) return 1;
            if (b.rank == null) return -1;

            return a.rank - b.rank;
          });

        return {
          competitionKey,
          competition:
            competitionTeams[0]?.competition ?? "",
          teams: competitionTeams,
        };
      });

    return {
      season,
      competitions,
    };
  })
  .filter(
    (seasonGroup) =>
      seasonGroup.competitions.length > 0
  );

// 大会・地域目次。リンク先が存在するものだけクリック可能にする。
// 都府県リーグ追加時は、該当チームに regionKey（例: "KANTO"）を指定する。
const regionIndex = [
  { key: "HOKKAIDO", label: "北海道" },
  { key: "TOHOKU", label: "東北" },
  { key: "KANTO", label: "関東" },
  { key: "HOKUSHINETSU", label: "北信越" },
  { key: "TOKAI", label: "東海" },
  { key: "KANSAI", label: "関西" },
  { key: "CHUGOKU", label: "中国" },
  { key: "SHIKOKU", label: "四国" },
  { key: "KYUSHU", label: "九州" }
];

const leagueIndex = [
  { key: "JSL1", label: "JSL1部" },
  { key: "JSL2", label: "JSL2部" },
  { key: "J", keys: ["J", "J1"], label: "Jリーグ／J1" },
  { key: "J2", label: "J2" },
  { key: "OLD_JFL", keys: ["OLD_JFL", "OLD_JFL1"], label: "旧JFL" },
  { key: "OLD_JFL2", label: "旧JFL2部" },
  { key: "JFL", label: "JFL" },
];

const regionalKeys = regionIndex.map((region) => region.key);
const regionOf = (team) =>
  team.regionKey ||
  (regionalKeys.includes(team.competitionKey) ? team.competitionKey : null);

// 各大会の収録シーズンから、既存ページ内アンカーへのリンクを生成する。
// Jリーグのステージ別順位表は、完成時に下記へ追加できる。
// 未完成の順位表は登録しない（架空のリンクを表示しない）。
const stageStandings = {
  // 例："J:1993": [
  //   { label: "サントリーシリーズ", href: "/standings/（完成したページのURL）" },
  //   { label: "NICOSシリーズ", href: "/standings/（完成したページのURL）" },
  // ],
};

const competitionSeasonLinks = (keys) =>
  groupedSeasons.flatMap((group) => {
    const matching = group.competitions.filter((entry) => keys.includes(entry.competitionKey));
    // J / J1 のような別キーを同一シーズン内で重複表示しない。
    return matching.length ? [{
      season: group.season,
      href: `#competition-${matching[0].competitionKey}-${group.season.replace(/[^0-9a-z]/gi, "-")}`,
      stages: stageStandings[`${keys[0]}:${group.season}`] ?? [],
    }] : [];
  });

// 小窓の各シーズン表記。大会の変遷に合わせて表示名だけ切り替える。
// チームの元データ（competition / competitionKey）は変更しない。
const seasonMenuLabel = (item, season) => {
  if (item.key === "J") {
    if (season === "1992") return "1992　ヤマザキナビスコカップ";
    return `${season === "1999" ? "J1" : "Jリーグ"}　${season}`;
  }
  if (item.key === "OLD_JFL") {
    return `${season === "1992" || season === "1993" ? "旧JFL1部" : "旧JFL"}　${season}`;
  }
  return `${item.label}　${season}`;
};

const regionSeasonLinks = (key) =>
  groupedSeasons.flatMap((group) => {
    const matching = group.competitions.filter((entry) =>
      entry.teams.some((team) => regionOf(team) === key)
    );
    return matching.map((entry) => ({
      season: group.season,
      href: `#competition-${entry.competitionKey}-${group.season.replace(/[^0-9a-z]/gi, "-")}`,
    }));
  });

---

<html lang="ja">
  <head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <title>
    1990年代 | 日本サッカーWEBデータベース
  </title>
</head>

  <body>
    <main>
      <p class="back">
        <a href="/">← トップへ戻る</a>
      </p>

      <p class="label">DECADE</p>

      <h1>1990年代</h1>

      <p class="intro">
        1990年代の日本サッカーを、シーズンとチームから辿る。
      </p>


      <nav class="archive-index" aria-label="大会・地域別目次">
        <h2>大会・地域から探す</h2>
        <p class="index-note">大会・地域名を押すと収録シーズンが小窓で開きます。シーズンを選ぶと掲載箇所へ移動します。</p>
        <h3>全国リーグ</h3>
        <div class="index-grid">
          {leagueIndex.map((item) => {
            const links = competitionSeasonLinks(item.keys ?? [item.key]);
            return links.length ? (
              <details class="index-dropdown">
                <summary class="index-item">{item.label}<span class="index-chevron" aria-hidden="true">⌄</span></summary>
                <div class="index-subitems">
                  {links.map((link) => (
                    link.stages.length ? (
                      <details class="index-nested-dropdown">
                        <summary class="index-subitem">{seasonMenuLabel(item, link.season)}<span class="index-chevron" aria-hidden="true">⌄</span></summary>
                        <div class="index-stage-items">
                          <a class="index-stage-link" href={link.href}>収録チームを見る <span aria-hidden="true">↓</span></a>
                          {link.stages.map((stage) => (
                            <a class="index-stage-link" href={stage.href}>{stage.label} <span aria-hidden="true">↗</span></a>
                          ))}
                        </div>
                      </details>
                    ) : (
                      <a class="index-subitem" href={link.href}>{seasonMenuLabel(item, link.season)}<span aria-hidden="true">↓</span></a>
                    )
                  ))}
                </div>
              </details>
            ) : (
              <span class="index-item index-disabled">{item.label}</span>
            );
          })}
        </div>
        <h3>地域リーグ・都道府県リーグ</h3>
        <div class="index-grid">
          {regionIndex.map((item) => {
            const links = regionSeasonLinks(item.key);
            return links.length ? (
              <details class="index-dropdown">
                <summary class="index-item">{item.label}<span class="index-chevron" aria-hidden="true">⌄</span></summary>
                <div class="index-subitems">
                  {links.map((link) => (
                    <a class="index-subitem" href={link.href}>{seasonMenuLabel(item, link.season)}<span aria-hidden="true">↓</span></a>
                  ))}
                </div>
              </details>
            ) : (
              <span class="index-item index-disabled">{item.label}</span>
            );
          })}
        </div>
        <p class="index-note">都府県リーグの階層は収録時に追加します。未収録の大会・地域は開けません。</p>
      </nav>

      <section class="archive-section">
        <h2>収録シーズン</h2>

        {
          groupedSeasons.map((seasonGroup) => (
            <div class="season-block">
              <div class="season-heading">
                {seasonGroup.season}
              </div>

              {
                seasonGroup.competitions.map(
                  (competitionGroup) => (
                    <div class="competition-group" id={`competition-${competitionGroup.competitionKey}-${seasonGroup.season.replace(/[^0-9a-z]/gi, "-")}`}>
                      <h3>
                        <span class="competition-name">
                          {
                            competitionGroup.competition
                          }
                        </span>

                        <span class="competition-season">
                          {seasonGroup.season}
                        </span>
                      </h3>

                      <div class="team-section">
                        <h4>収録チーム</h4>

                        <div class="team-list">
                          {
                            competitionGroup.teams.map(
                              (team) => (
                                <a href={team.url}>
                                  <span class="team-rank">
                                    {
                                      team.rank != null
                                        ? `${team.rank}位`
                                        : "—"
                                    }
                                  </span>

                                  <strong>
                                    {team.name}
                                  </strong>
                                </a>
                              )
                            )
                          }
                        </div>
                      </div>
                    </div>
                  )
                )
              }
            </div>
          ))
        }
      </section>
    </main>

  <script>
    // マウス操作では小窓から離れたら閉じる。タッチ・キーボードはクリック開閉を維持。
    document.querySelectorAll(".index-dropdown").forEach((dropdown) => {
      if (!(dropdown instanceof HTMLDetailsElement)) return;
      let closeTimer;
      dropdown.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse") return;
        window.clearTimeout(closeTimer);
      });
      dropdown.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "mouse") return;
        closeTimer = window.setTimeout(() => {
          dropdown.open = false;
          dropdown.querySelectorAll("details[open]").forEach((nested) => {
            nested.open = false;
          });
        }, 180);
      });
    });
  </script>
  </body>
</html>

<style>

  .archive-index {
    margin-top: 42px;
    padding: 26px;
    background: #ffffff;
    border: 1px solid #cfd5d0;
  }
  .archive-index h2 { margin: 0 0 8px; }
  .archive-index h3 { display: block; margin: 25px 0 12px; font-size: 15px; }
  .index-note { margin: 8px 0; color: #68716b; font-size: 12px; line-height: 1.7; }
  .index-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .index-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 46px;
    padding: 12px 14px;
    border: 1px solid #cfd5d0;
    border-radius: 7px;
    background: #fff;
    color: #202522;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .index-dropdown {
    position: relative;
    min-width: 0;
  }
  .index-dropdown summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .index-dropdown summary::-webkit-details-marker { display: none; }
  .index-dropdown summary:hover,
  .index-dropdown[open] summary {
    background: #f3f6f3;
    border-color: #9eaaa1;
  }
  .index-dropdown[open] { z-index: 20; }
  .index-dropdown[open] summary {
    box-shadow: 0 0 0 2px rgba(92, 112, 98, 0.08);
  }
  .index-dropdown summary:focus-visible,
  .index-subitem:focus-visible {
    outline: 2px solid #476d53;
    outline-offset: 2px;
  }
  .index-chevron {
    display: inline-block;
    color: #68716b;
    font-size: 19px;
    font-weight: 500;
    line-height: 1;
    transition: transform 0.18s ease;
  }
  .index-dropdown[open] .index-chevron { transform: rotate(180deg); }
  .index-subitems {
    position: absolute;
    top: calc(100% + 7px);
    left: 0;
    z-index: 30;
    width: max(100%, 225px);
    max-width: min(320px, calc(100vw - 36px));
    max-height: 320px;
    overflow-y: auto;
    padding: 6px;
    border: 1px solid #d4dbd5;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(24, 38, 28, 0.15), 0 3px 8px rgba(24, 38, 28, 0.06);
  }
  .index-subitem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 12px;
    border-radius: 6px;
    color: #202522;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.12s ease;
  }
  .index-subitem + .index-subitem { border-top: 1px solid #eef1ee; }
  .index-subitem:hover { background: #edf2ee; }
  .index-subitem span { color: #7b8980; }
  .index-disabled { background: #f4f5f3; color: #9ba29d; }
  /* 将来の複数ステージ順位表用：シーズンを開くと小窓内にもう一段表示。 */
  .index-nested-dropdown summary { list-style: none; cursor: pointer; }
  .index-nested-dropdown summary::-webkit-details-marker { display: none; }
  .index-nested-dropdown[open] > summary { background: #edf2ee; }
  .index-nested-dropdown[open] > summary .index-chevron { transform: rotate(180deg); }
  .index-stage-items { margin: 2px 5px 8px 12px; padding-left: 10px; border-left: 2px solid #d8e1da; }
  .index-stage-link { display: flex; justify-content: space-between; gap: 8px; padding: 9px 10px; border-radius: 5px; color: #37453b; font-size: 12px; text-decoration: none; }
  .index-stage-link:hover { background: #edf2ee; }
  .index-stage-link span { color: #7b8980; }
  .index-nested-dropdown summary:focus-visible, .index-stage-link:focus-visible { outline: 2px solid #476d53; outline-offset: 2px; }
  .competition-group { scroll-margin-top: 24px; }
  @media (max-width: 700px) {
    .archive-index { padding: 18px; }
    .index-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Noto Sans JP",
      sans-serif;
  }

