            <div class="team-list">
              <a href="/teams/toshiba-89-90">
                <span>89/90</span>
                <strong>東芝</strong>
              </a>
            </div>
          </div>
        </div>

        <!-- 日本サッカーリーグ 88/89 -->
        <div class="season-group">
          <h3>
            <span class="competition-name">日本サッカーリーグ</span>
            <span class="competition-season">88/89</span>
          </h3>

          <div class="team-section">
            <h4>収録チーム</h4>

            <div class="team-list">
              <a href="/teams/toshiba-88-89">
                <span>88/89</span>
