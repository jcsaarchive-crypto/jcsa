</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Noto Sans JP", sans-serif;
  }

  main {
    width: min(1000px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 90px;
  }

  .back {
    margin: 0 0 55px;
    font-size: 14px;
  }

  .back a {
    color: #68716b;
    text-decoration: none;
  }

  .label {
    margin: 0 0 8px;
    color: #68716b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(36px, 6vw, 56px);
  }

  .intro {
    margin: 0;
    color: #68716b;
  }

  .archive-section {
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid #cfd5d0;
  }

  h2 {
    margin: 0 0 26px;
    font-size: 22px;
  }

  .season-group {
    max-width: 700px;
  }

  .season-group + .season-group {
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid #d9ddda;
  }

  h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 17px;
    font-size: 18px;
    line-height: 1.4;
  }

  .competition-name {
    font-weight: 700;
  }

  .competition-season {
    color: #68716b;
    font-size: 14px;
    font-weight: 600;
  }

  .team-section {
    padding-left: 18px;
  }

  h4 {
    margin: 0 0 10px;
    color: #68716b;
    font-size: 12px;
    font-weight: 700;
  }

  .team-list {
    display: grid;
    gap: 12px;
  }

  .team-list a {
    display: flex;
    align-items: center;
    gap: 25px;
    padding: 16px 18px;
    background: white;
    border: 1px solid #cfd5d0;
    color: #202522;
    text-decoration: none;
  }

  .team-list a:hover {
    background: #e7ebe8;
  }

  .team-list span {
    min-width: 55px;
    color: #68716b;
    font-size: 14px;
  }

  .team-list strong {
    font-size: 16px;
  }

  @media (max-width: 700px) {
    main {
      width: calc(100% - 24px);
      padding-top: 40px;
    }

    .team-section {
      padding-left: 0;
    }

    h3 {
      flex-wrap: wrap;
      gap: 5px 10px;
    }
  }
</style>