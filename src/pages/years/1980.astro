---
const teams = [
  {
    season: "88/89",
    competitionKey: "JSL2",
    competition: "日本サッカーリーグ2部",
    rank: 1,
    name: "東芝",
    url: "/teams/toshiba-88-89",
  },
  {
    season: "88/89",
    competitionKey: "JSL2",
    competition: "日本サッカーリーグ2部",
    rank: 2,
    name: "トヨタ自動車",
    url: "/teams/toyota-88-89",
  },
  {
    season: "88/89",
    competitionKey: "JSL2",
    competition: "日本サッカーリーグ2部",
    rank: 4,
    name: "富士通",
    url: "/teams/fujitsu-88-89",
  },
  {
    season: "89/90",
    competitionKey: "JSL1",
    competition: "日本サッカーリーグ1部",
    rank: 9,
    name: "東芝",
    url: "/teams/toshiba-89-90",
  },
  {
    season: "89/90",
    competitionKey: "JSL2",
    competition: "日本サッカーリーグ2部",
    rank: 2,
    name: "トヨタ自動車",
    url: "/teams/toyota-89-90",
  },
];

const seasonOrder = [
  "1980",
  "80/81",
  "1981",
  "81/82",
  "1982",
  "82/83",
  "1983",
  "83/84",
  "1984",
  "84/85",
  "1985",
  "85/86",
  "1986",
  "86/87",
  "1987",
  "87/88",
  "1988",
  "88/89",
  "1989",
  "89/90",
];

const competitionOrder = [
  "JSL1",
  "JSL2",

  "HOKKAIDO",
  "TOHOKU",
  "KANTO",
  "HOKUSHINETSU",
  "TOKAI",
  "KANSAI",
  "CHUGOKU",
  "SHIKOKU",
  "KYUSHU",
];

const registeredSeasons = [
  ...new Set(teams.map((team) => team.season)),
];

const allSeasons = [
  ...seasonOrder.filter((season) =>
    registeredSeasons.includes(season)
  ),
  ...registeredSeasons.filter(
    (season) => !seasonOrder.includes(season)
  ),
];

const groupedSeasons = allSeasons
  .map((season) => {
    const seasonTeams = teams.filter(
      (team) => team.season === season
    );

    const competitionKeys = [
      ...new Set(
        seasonTeams.map((team) => team.competitionKey)
      ),
    ];

    const competitions = competitionKeys
      .sort((a, b) => {
        const aIndex = competitionOrder.indexOf(a);
        const bIndex = competitionOrder.indexOf(b);

        const aOrder =
          aIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : aIndex;

        const bOrder =
          bIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : bIndex;

        return aOrder - bOrder;
      })
      .map((competitionKey) => {
        const competitionTeams = seasonTeams
          .filter(
            (team) =>
              team.competitionKey === competitionKey
          )
          .sort((a, b) => {
            if (a.rank == null && b.rank == null) {
              return a.name.localeCompare(
                b.name,
                "ja"
              );
            }

            if (a.rank == null) return 1;
            if (b.rank == null) return -1;

            return a.rank - b.rank;
          });

        return {
          competitionKey,
          competition:
            competitionTeams[0]?.competition ?? "",
          teams: competitionTeams,
        };
      });

    return {
      season,
      competitions,
    };
  })
  .filter(
    (seasonGroup) =>
      seasonGroup.competitions.length > 0
  );
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <title>
      1980年代 | 日本サッカーWEBデータベース
    </title>
  </head>

  <body>
    <main>
      <p class="back">
        <a href="/">← トップへ戻る</a>
      </p>

      <p class="label">DECADE</p>

      <h1>1980年代</h1>

      <p class="intro">
        1980年代の日本サッカーを、シーズンとチームから辿る。
      </p>

      <section class="archive-section">
        <h2>収録シーズン</h2>

        {
          groupedSeasons.map((seasonGroup) => (
            <div class="season-block">
              <div class="season-heading">
                {seasonGroup.season}
              </div>

              {
                seasonGroup.competitions.map(
                  (competitionGroup) => (
                    <div class="competition-group">
                      <h3>
                        <span class="competition-name">
                          {
                            competitionGroup.competition
                          }
                        </span>

                        <span class="competition-season">
                          {seasonGroup.season}
                        </span>
                      </h3>

                      <div class="team-section">
                        <h4>収録チーム</h4>

                        <div class="team-list">
                          {
                            competitionGroup.teams.map(
                              (team) => (
                                <a href={team.url}>
                                  <span class="team-rank">
                                    {
                                      team.rank != null
                                        ? `${team.rank}位`
                                        : "—"
                                    }
                                  </span>

                                  <strong>
                                    {team.name}
                                  </strong>
                                </a>
                              )
                            )
                          }
                        </div>
                      </div>
                    </div>
                  )
                )
              }
            </div>
          ))
        }
      </section>
    </main>
  </body>
</html>

