const seasonOrder = [
  "1980",
  "80/81",
  "1981",
  "81/82",
  "1982",
  "82/83",
  "1983",
  "83/84",
  "1984",
  "84/85",
  "1985",
  "85/86",
  "1986",
  "86/87",
  "1987",
  "87/88",
  "1988",
  "88/89",
  "1989",
  "89/90",
];

const competitionOrder = [
  "JSL1",
  "JSL2",

  "HOKKAIDO",
  "TOHOKU",
  "KANTO",
  "HOKUSHINETSU",
  "TOKAI",
  "KANSAI",
  "CHUGOKU",
  "SHIKOKU",
  "KYUSHU",
];

const registeredSeasons = [
  ...new Set(teams.map((team) => team.season)),
];

const allSeasons = [
  ...seasonOrder.filter((season) =>
    registeredSeasons.includes(season)
  ),
  ...registeredSeasons.filter(
    (season) => !seasonOrder.includes(season)
  ),
];

const groupedSeasons = allSeasons
  .map((season) => {
    const seasonTeams = teams.filter(
      (team) => team.season === season
    );

    const competitionKeys = [
      ...new Set(
        seasonTeams.map((team) => team.competitionKey)
      ),
    ];

    const competitions = competitionKeys
      .sort((a, b) => {
        const aIndex = competitionOrder.indexOf(a);
        const bIndex = competitionOrder.indexOf(b);

        const aOrder =
          aIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : aIndex;

        const bOrder =
          bIndex === -1
            ? Number.MAX_SAFE_INTEGER
            : bIndex;

        return aOrder - bOrder;
      })
      .map((competitionKey) => {
        const competitionTeams = seasonTeams
          .filter(
            (team) =>
              team.competitionKey === competitionKey
          )
          .sort((a, b) => {
            if (a.rank == null && b.rank == null) {
              return a.name.localeCompare(
                b.name,
                "ja"
              );
            }

            if (a.rank == null) return 1;
            if (b.rank == null) return -1;

            return a.rank - b.rank;
          });

        return {
          competitionKey,
          competition:
            competitionTeams[0]?.competition ?? "",
          teams: competitionTeams,
        };
      });

    return {
      season,
      competitions,
    };
  })
  .filter(
    (seasonGroup) =>
      seasonGroup.competitions.length > 0
  );

// 大会・地域目次。リンク先が存在するものだけクリック可能にする。
// 都府県リーグ追加時は、該当チームに regionKey（例: "KANTO"）を指定する。
const regionIndex = [
  { key: "HOKKAIDO", label: "北海道" },
  { key: "TOHOKU", label: "東北" },
  { key: "KANTO", label: "関東" },
  { key: "HOKUSHINETSU", label: "北信越" },
  { key: "TOKAI", label: "東海" },
  { key: "KANSAI", label: "関西" },
  { key: "CHUGOKU", label: "中国" },
  { key: "SHIKOKU", label: "四国" },
  { key: "KYUSHU", label: "九州" }
];

const leagueIndex = [
  { key: "JSL1", label: "JSL1部" },
  { key: "JSL2", label: "JSL2部" },
];

const regionalKeys = regionIndex.map((region) => region.key);
const regionOf = (team) =>
  team.regionKey ||
  (regionalKeys.includes(team.competitionKey) ? team.competitionKey : null);

// 目次の階層を将来拡張できるよう、項目ごとにシーズンのリンクを生成する。
// 現段階では「リーグ・地域 → シーズン」の2階層のみを表示する。
const competitionSeasonLinks = (key) =>
  groupedSeasons.flatMap((group) =>
    group.competitions
      .filter((competition) => competition.competitionKey === key)
      .map((competition) => ({
        season: group.season,
        href: `#competition-${competition.competitionKey}-${group.season.replace(/[^0-9a-z]/gi, "-")}`,
      }))
  );

const regionSeasonLinks = (key) =>
  groupedSeasons.flatMap((group) => {
    const matching = group.competitions.filter((competition) =>
      competition.teams.some((team) => regionOf(team) === key)
    );
    return matching.map((competition) => ({
      season: group.season,
      href: `#competition-${competition.competitionKey}-${group.season.replace(/[^0-9a-z]/gi, "-")}`,
    }));
  });

---

<html lang="ja">
  <head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <title>
    1980年代 | 日本クラブサッカーアーカイブ
  </title>
</head>

  <body>
    <main>
      <p class="back">
        <a href="/">← トップへ戻る</a>
      </p>

      <p class="label">DECADE</p>

      <h1>1980年代</h1>

      <p class="intro">
        1980年代の日本サッカーを、シーズンとチームから辿る。
      </p>


      <nav class="archive-index" aria-label="大会・地域別目次">
        <h2>大会・地域から探す</h2>
        <p class="index-note">リーグ・地域名を押すと収録済みシーズンが開きます。シーズン名から該当箇所へ移動できます。</p>
        <h3>全国リーグ</h3>
        <div class="index-grid">
          {leagueIndex.map((item) => {
            const links = competitionSeasonLinks(item.key);
            return links.length ? (
              <details class="index-dropdown">
                <summary class="index-item">{item.label}<span class="index-chevron" aria-hidden="true">⌄</span></summary>
                <div class="index-subitems">
                  {links.map((link) => (
                    <a class="index-subitem" href={link.href}>{item.label}　{link.season}<span aria-hidden="true">↓</span></a>
                  ))}
                </div>
              </details>
            ) : (
              <span class="index-item index-disabled">{item.label}</span>
            );
          })}
        </div>
        <h3>地域リーグ・都道府県リーグ</h3>
        <div class="index-grid">
          {regionIndex.map((item) => {
            const links = regionSeasonLinks(item.key);
            return links.length ? (
              <details class="index-dropdown">
                <summary class="index-item">{item.label}<span class="index-chevron" aria-hidden="true">⌄</span></summary>
                <div class="index-subitems">
                  {links.map((link) => (
                    <a class="index-subitem" href={link.href}>{item.label}　{link.season}<span aria-hidden="true">↓</span></a>
                  ))}
                </div>
              </details>
            ) : (
              <span class="index-item index-disabled">{item.label}</span>
            );
          })}
        </div>
        <p class="index-note">都府県リーグの階層は、収録時に追加します。未収録の地域は開けません。</p>
      </nav>

      <section class="archive-section">
        <h2>収録シーズン</h2>

        {
          groupedSeasons.map((seasonGroup) => (
            <div class="season-block">
              <div class="season-heading">
                {seasonGroup.season}
              </div>

              {
                seasonGroup.competitions.map(
                  (competitionGroup) => (
                    <div class="competition-group" id={`competition-${competitionGroup.competitionKey}-${seasonGroup.season.replace(/[^0-9a-z]/gi, "-")}`}>
                      <h3>
                        <span class="competition-name">
                          {
                            competitionGroup.competition
                          }
                        </span>

                        <span class="competition-season">
                          {seasonGroup.season}
                        </span>
                      </h3>

                      {seasonGroup.season === "89/90" && competitionGroup.competitionKey === "JSL1" && (
  <p class="standings-link">
    <a href="/standings/1989-90-jsl1">最終順位表を見る →</a>
  </p>
)}

                      {seasonGroup.season === "88/89" && competitionGroup.competitionKey === "JSL1" && (
                        <p class="standings-link">
                          <a href="/standings/1988-89-jsl1">最終順位表を見る →</a>
                        </p>
                      )}

                      {seasonGroup.season === "88/89" && competitionGroup.competitionKey === "JSL2" && (
                        <p class="standings-link">
                          <a href="/standings/1988-89-jsl2">最終順位表を見る →</a>
                        </p>
                      )}

                      <div class="team-section">
                        <h4>収録チーム</h4>

                        <div class="team-list">
                          {
                            competitionGroup.teams.map(
                              (team) => (
                                <a href={team.url}>
                                  <span class="team-rank">
                                    {
                                      team.rank != null
                                        ? `${team.rank}位`
                                        : "—"
                                    }
                                  </span>

                                  <strong>
                                    {team.name}
                                  </strong>
                                </a>
                              )
                            )
                          }
                        </div>
                      </div>
                    </div>
                  )
                )
              }
            </div>
          ))
        }
      </section>
    </main>
    <script>
      // 窓型メニュー：マウスが外れたら少し待って閉じる。
      // タッチ操作は details/summary の標準動作を維持する。
      const dropdowns = document.querySelectorAll<HTMLDetailsElement>(".index-dropdown");

      dropdowns.forEach((dropdown) => {
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        const cancelClose = () => {
          if (closeTimer !== undefined) {
            clearTimeout(closeTimer);
            closeTimer = undefined;
          }
        };

        dropdown.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "mouse") cancelClose();
        });

        dropdown.addEventListener("pointerleave", (event) => {
          if (event.pointerType !== "mouse") return;
          cancelClose();
          closeTimer = setTimeout(() => {
            dropdown.open = false;
            closeTimer = undefined;
          }, 180);
        });

        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) cancelClose();
        });
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          dropdowns.forEach((dropdown) => (dropdown.open = false));
        }
      });
    </script>
  </body>
</html>

<style>

  .archive-index {
    margin-top: 42px;
    padding: 26px;
    background: #ffffff;
    border: 1px solid #cfd5d0;
  }
  .archive-index h2 { margin: 0 0 8px; }
  .archive-index h3 { display: block; margin: 25px 0 12px; font-size: 15px; }
  .index-note { margin: 8px 0; color: #68716b; font-size: 12px; line-height: 1.7; }
  .index-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .index-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 46px;
    padding: 12px 14px;
    border: 1px solid #cfd5d0;
    border-radius: 7px;
    background: #fff;
    color: #202522;
    text-decoration: none;
