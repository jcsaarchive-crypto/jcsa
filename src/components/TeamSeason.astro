---
import { getPlayerUrl } from "../data/links.js";

const {
  team,
  players,
  staff = [],
  sources = [],
} = Astro.props;

const birthColumnLabel =
  team.birthColumnLabel ?? "生年月日";

const hasLongBirthColumnLabel =
  birthColumnLabel !== "生年月日";

const leagueGoalDifference =
  team.results?.league?.goalDifference ??
  (
    team.results?.league
      ? team.results.league.goalsFor -
        team.results.league.goalsAgainst
      : 0
  );

const getGoalDifference = (result) =>
  result?.goalDifference ??
  (
    result
      ? result.goalsFor - result.goalsAgainst
      : 0
  );
---

<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{team.season} {team.name}</title>
</head>

<body>
  <main>
    <div class="top-nav">
      <a href="/">← トップへ戻る</a>
    </div>

    {team.seasonNavigation && (
      <nav
        class="season-navigation"
        aria-label="クラブ年度ナビゲーション"
      >
        <div
          class="season-navigation-side season-navigation-previous"
        >
          {team.seasonNavigation.previous && (
            team.seasonNavigation.previous.url ? (
              <a
                href={team.seasonNavigation.previous.url}
                class="season-navigation-item"
              >
                <span class="season-navigation-direction">
                  ← 前年
                </span>
                <span class="season-navigation-label">
                  {team.seasonNavigation.previous.label}
                </span>
              </a>
            ) : (
              <div
                class="season-navigation-item season-navigation-unlinked"
              >
                <span class="season-navigation-direction">
                  ← 前年
                </span>
                <span class="season-navigation-label">
                  {team.seasonNavigation.previous.label}
                </span>
              </div>
            )
          )}
        </div>

        <div
          class="season-navigation-side season-navigation-next"
        >
          {team.seasonNavigation.next && (
            team.seasonNavigation.next.url ? (
              <a
                href={team.seasonNavigation.next.url}
                class="season-navigation-item"
              >
                <span class="season-navigation-direction">
                  翌年 →
                </span>
                <span class="season-navigation-label">
                  {team.seasonNavigation.next.label}
                </span>
              </a>
            ) : (
              <div
                class="season-navigation-item season-navigation-unlinked"
              >
                <span class="season-navigation-direction">
                  翌年 →
                </span>
                <span class="season-navigation-label">
                  {team.seasonNavigation.next.label}
                </span>
              </div>
            )
          )}
        </div>
      </nav>
    )}

    <div class="league">{team.competitionEn}</div>

    <h1>{team.name}</h1>

    <p class="season">
      <strong class="season-year">{team.season}</strong>
      <span class="season-competition">{team.competition}</span>
    </p>

    <!-- クラブ情報 -->
    <section class="info-section">
      <h2>クラブ情報</h2>

      <div class="info-box">
        <dl class="info-list">
          {team.corporateName && (
            <>
              <dt>法人名</dt>
              <dd>{team.corporateName}</dd>
            </>
          )}

          {team.officialName && (
            <>
              <dt>正式名称</dt>
              <dd>{team.officialName}</dd>
            </>
          )}

          {team.abbreviation && (
            <>
              <dt>略称</dt>
              <dd>{team.abbreviation}</dd>
            </>
          )}

          {team.location && (
            <>
              <dt>所在地</dt>
              <dd>{team.location}</dd>
            </>
          )}

          {team.founding && (
            <>
              <dt>創部</dt>
              <dd>
                {team.founding.year}年
                {team.founding.note && (
                  <span class="sub-note">
                    （{team.founding.note}）
                  </span>
                )}
              </dd>
            </>
          )}

          {team.trainingGround && (
            <>
              <dt>練習場</dt>
              <dd>{team.trainingGround}</dd>
            </>
          )}

          {team.mainGrounds?.length > 0 && (
            <>
              <dt>主な使用グラウンド</dt>
              <dd>
                <ul class="ground-list">
                  {team.mainGrounds.map((ground) => (
                    <li>{ground}</li>
                  ))}
                </ul>
              </dd>
            </>
          )}
        </dl>
      </div>
    </section>

    <!-- 今シーズンの成績 -->
    {team.results && (
      <section class="info-section">
        <h2>今シーズンの成績</h2>

        <div class="result-box">
          {team.results.league && (
            <>
              <h3>{team.results.league.competition}</h3>

              {team.results.league.stages?.length > 0 ? (
                <>
                  <div class="stage-results">
                    {team.results.league.stages.map((stage) => {
                      const stageGoalDifference =
                        getGoalDifference(stage);

                      return (
                        <div class="stage-result-block">
                          <h4>{stage.name}</h4>

                          <div class="league-result">
                            <div class="result-rank">
                              <span>順位</span>
                              <strong>{stage.rank}位</strong>
                            </div>

                            <div class="result-stats">
                              {stage.points !== undefined && (
                                <div>
                                  <span>勝点</span>
                                  <strong>{stage.points}</strong>
                                </div>
                              )}

                              <div>
                                <span>成績</span>
                                <strong>
                                  {stage.wins}勝
                                  {stage.vGoalWins !== undefined &&
                                    `${stage.vGoalWins}Vゴール勝`}
                                  {stage.pkWins !== undefined &&
                                    `${stage.pkWins}PK勝`}
                                  {stage.draws !== undefined &&
                                    `${stage.draws}分`}
                                  {stage.losses}敗
                                  {stage.pkLosses !== undefined &&
                                    stage.pkLosses > 0 &&
                                    `${stage.pkLosses}PK負け`}
                                </strong>
                              </div>

                              <div>
                                <span>得点</span>
                                <strong>{stage.goalsFor}</strong>
                              </div>

                              <div>
                                <span>失点</span>
                                <strong>{stage.goalsAgainst}</strong>
                              </div>

                              <div>
                                <span>得失点差</span>
                                <strong>
                                  {stageGoalDifference > 0 ? "+" : ""}
                                  {stageGoalDifference}
                                </strong>
                              </div>
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>

                  {team.results.league.overall && (
                    <div class="overall-result-block">
                      <h4>総合</h4>

                      <div class="league-result">
                        <div class="result-rank">
                          <span>順位</span>
                          <strong>
                            {team.results.league.overall.rank}位
                          </strong>
                        </div>

                        <div class="result-stats">
                          {team.results.league.overall.points !==
                            undefined && (
                            <div>
                              <span>勝点</span>
                              <strong>
                                {team.results.league.overall.points}
                              </strong>
                            </div>
                          )}

                          <div>
                            <span>成績</span>
                            <strong>
                              {team.results.league.overall.wins}勝
                              {team.results.league.overall.draws !==
                                undefined &&
                                `${team.results.league.overall.draws}分`}
                              {team.results.league.overall.losses}敗
                            </strong>
                          </div>

                          <div>
                            <span>得点</span>
                            <strong>
                              {team.results.league.overall.goalsFor}
                            </strong>
                          </div>

                          <div>
                            <span>失点</span>
                            <strong>
                              {team.results.league.overall.goalsAgainst}
                            </strong>
                          </div>

                          <div>
                            <span>得失点差</span>
                            <strong>
                              {getGoalDifference(
                                team.results.league.overall
                              ) > 0
                                ? "+"
                                : ""}
                              {getGoalDifference(
                                team.results.league.overall
                              )}
                            </strong>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </>
              ) : (
                <div class="league-result">
                  <div class="result-rank">
                    <span>順位</span>
                    <strong>{team.results.league.rank}位</strong>
                  </div>

                  <div class="result-stats">
                    {team.results.league.points !== undefined && (
                      <div>
                        <span>勝点</span>
                        <strong>{team.results.league.points}</strong>
                      </div>
                    )}

                    <div>
                      <span>成績</span>
                      <strong>
                        {team.results.league.wins}勝
                        {team.results.league.vGoalWins !== undefined &&
                          `${team.results.league.vGoalWins}Vゴール勝`}
                        {team.results.league.pkWins !== undefined &&
                          `${team.results.league.pkWins}PK勝`}
                        {team.results.league.draws !== undefined &&
                          `${team.results.league.draws}分`}
                        {team.results.league.losses}敗
                        {team.results.league.pkLosses !== undefined &&
                          team.results.league.pkLosses > 0 &&
                          `${team.results.league.pkLosses}PK負け`}
                      </strong>
                    </div>

                    <div>
                      <span>得点</span>
                      <strong>{team.results.league.goalsFor}</strong>
                    </div>

                    <div>
                      <span>失点</span>
                      <strong>{team.results.league.goalsAgainst}</strong>
                    </div>

                    <div>
                      <span>得失点差</span>
                      <strong>
                        {leagueGoalDifference > 0 ? "+" : ""}
                        {leagueGoalDifference}
                      </strong>
                    </div>
                  </div>
                </div>
              )}
            </>
          )}

          <div class="cup-results">
            {team.results.jslCup && (
              <div>
                <span>JSLカップ</span>
                <strong>{team.results.jslCup}</strong>
              </div>
            )}

            {team.results.nabiscoCup && (
              <div>
                <span>ナビスコカップ</span>
                <strong>{team.results.nabiscoCup}</strong>
              </div>
            )}

            {team.results.emperorCup && (
              <div>
                <span>天皇杯</span>
                <strong>{team.results.emperorCup}</strong>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 選手一覧 -->
    <section class="players-section">
      <h2>選手一覧</h2>

      <div class="table-wrap">
        <table class:list={{ "long-birth-column": hasLongBirthColumnLabel }}>
          <thead>
            <tr>
              <th class="number-column">背番号</th>
              <th class="name-column">選手名</th>
              <th class="latin-column">ラテン文字表記</th>
              <th class="position-column">Pos</th>
              <th class="birth-column">{birthColumnLabel}</th>
              <th class="size-column">身長/体重</th>
              <th class="birthplace-column">出身地</th>
              <th class="previous-column">前所属チーム</th>
            </tr>
          </thead>

          <tbody>
            {players.map((player) => {
              const playerUrl = getPlayerUrl(player.id);

              return (
                <tr>
                  <td class="number number-column">
                    {player.number}
                  </td>

                  <td class="player-name name-column">
                    {playerUrl ? (
                      <a href={playerUrl}>{player.name}</a>
                    ) : (
                      player.name
                    )}
                  </td>

                  <td class="latin-column">
                    {player.latin}
                  </td>

                  <td class="position position-column">
                    {player.position}
                  </td>

                  <td class="birth-column">
                    {player.birth}
                  </td>

                  <td class="size-column">
                    {player.size}
                  </td>

                  <td class="birthplace-column">
                    {player.birthplace}
                  </td>

                  <td class="previous-column">
                    <span class="previous-text">
                      {player.previous}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- スタッフ -->
    {staff.length > 0 && (
      <section class="staff-section">
        <h2>スタッフ</h2>

        <div class="staff-box">
          <dl class="staff-list">
            {staff.map((member) => {
              const staffUrl = getPlayerUrl(member.id);

              return (
                <div class="staff-row">
                  <dt>{member.role}</dt>
                  <dd>
                    {staffUrl ? (
                      <a href={staffUrl}>{member.name}</a>
                    ) : (
                      member.name
                    )}
                  </dd>
                </div>
              );
            })}
          </dl>
        </div>
      </section>
    )}

    <!-- 出典・参考資料 -->
    {sources.length > 0 && (
      <section class="sources-section">
        <h2>出典・参考資料</h2>

        <div class="sources-box">
          <ol class="source-list">
            {sources.map((source) => (
              <li class="source-item">
                <div class="source-title">
                  『{source.title}』
                </div>

                <div class="source-details">
                  {source.publisher && (
                    <span>{source.publisher}</span>
                  )}

                  {source.year && (
                    <span>{source.year}</span>
                  )}

                  {source.isbn && (
                    <span>{source.isbn}</span>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </main>

  <script>
    const fitPreviousTeams = () => {
      const elements =
        document.querySelectorAll(".previous-text");

      elements.forEach((element) => {
        if (!(element instanceof HTMLElement)) return;

        element.classList.remove(
          "is-one-line",
          "is-two-lines",
          "is-small",
          "is-smaller",
          "is-smallest"
        );

        /*
          まず通常サイズ・1段で確認。
          セル幅に収まっている選手はそのまま。
        */
        const probe = element.cloneNode(true);

        if (!(probe instanceof HTMLElement)) return;

        probe.classList.remove(
          "is-one-line",
          "is-two-lines",
          "is-small",
          "is-smaller",
          "is-smallest"
        );

        probe.classList.add("is-measuring-one-line");

        probe.style.position = "fixed";
        probe.style.left = "-100000px";
        probe.style.top = "0";
        probe.style.width = "max-content";
        probe.style.maxWidth = "none";
        probe.style.visibility = "hidden";
        probe.style.pointerEvents = "none";

        document.body.appendChild(probe);

        const oneLineWidth =
          probe.getBoundingClientRect().width;

        const availableWidth =
          element.clientWidth;

        probe.remove();

        const oneLineFits =
          oneLineWidth <= availableWidth + 1;

        if (oneLineFits) {
          element.classList.add("is-one-line");
          return;
        }

        /*
          1段ではみ出した選手だけ2段表示。
        */
        element.classList.add("is-two-lines");

        const fitsTwoLines = () => {
          const style =
            getComputedStyle(element);

          const lineHeight =
            parseFloat(style.lineHeight);

          return (
            element.scrollHeight <=
            lineHeight * 2 + 1
          );
        };

        /*
          通常サイズの2段で収まれば終了。
        */
        if (fitsTwoLines()) {
          return;
        }

        /*
          2段でも収まらない場合だけ縮小。
          13px → 12px → 11px。
        */
        element.classList.add("is-small");

        if (fitsTwoLines()) {
          return;
        }

        element.classList.remove("is-small");
        element.classList.add("is-smaller");

        if (fitsTwoLines()) {
          return;
        }

        element.classList.remove("is-smaller");
        element.classList.add("is-smallest");
      });
    };

    const runPreviousTeamFit = () => {
      requestAnimationFrame(() => {
        fitPreviousTeams();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        runPreviousTeamFit
      );
    } else {
      runPreviousTeamFit();
    }

    if (document.fonts?.ready) {
      document.fonts.ready.then(
        runPreviousTeamFit
      );
    }

    window.addEventListener(
      "resize",
      runPreviousTeamFit
    );
  </script>
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f4f5f3;
    color: #202522;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Noto Sans JP", sans-serif;
  }

  main {
    width: min(1400px, calc(100% - 40px));
    margin: 0 auto;
    padding: 50px 0 80px;
  }

  .top-nav {
    margin-bottom: 28px;
    font-size: 11px;
  }

  .top-nav a {
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }

  .top-nav a:hover {
    text-decoration: underline;
  }

  .season-navigation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    margin: 0 0 28px;
    padding: 12px 0;
    border-top: 1px solid #cfd5d0;
    border-bottom: 1px solid #cfd5d0;
  }

  .season-navigation-side {
    min-width: 0;
  }

  .season-navigation-next {
    text-align: right;
  }

  .season-navigation-item {
    display: inline-flex;
    flex-direction: column;
    max-width: 100%;
    color: #2563eb;
    text-decoration: none;
  }

  .season-navigation-next .season-navigation-item {
    align-items: flex-end;
  }

  .season-navigation-direction {
    color: #68716b;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
  }

  .season-navigation-label {
    margin-top: 2px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.45;
  }

  a.season-navigation-item:hover .season-navigation-label {
    text-decoration: underline;
  }

  .season-navigation-unlinked {
    cursor: default;
  }

  .season-navigation-unlinked .season-navigation-label {
    color: #68716b;
  }

  .league {
    margin-bottom: 7px;
    color: #68716b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.2;
  }

  .season {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 8px 0 42px;
    color: #68716b;
  }

  .season-year {
    color: #202522;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }

  .season-competition {
    font-size: 14px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 21px;
    line-height: 1.4;
  }

  h3 {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .info-section,
  .players-section,
  .staff-section,
  .sources-section {
    margin-top: 38px;
  }

  .info-box,
  .result-box,
  .staff-box,
  .sources-box {
    background: white;
    border: 1px solid #cfd5d0;
  }

  /* クラブ情報 */

  .info-list {
    display: grid;
    grid-template-columns: 180px 1fr;
    margin: 0;
    font-size: 14px;
  }

  .info-list dt,
  .info-list dd {
    margin: 0;
    padding: 9px 11px;
    border-bottom: 1px solid #e0e4e1;
    line-height: 1.6;
  }

  .info-list dt {
    background: #e7ebe8;
    font-weight: 700;
  }

  .info-list dd {
    background: white;
  }

  .info-list dt:last-of-type,
  .info-list dd:last-of-type {
    border-bottom: 0;
  }

  .sub-note {
    margin-left: 8px;
    color: #68716b;
  }

  .ground-list {
    margin: 0;
    padding-left: 20px;
  }

  .ground-list li + li {
    margin-top: 3px;
  }

  /* 成績 */

  .result-box {
    padding: 20px;
  }

  .result-box h3 {
    margin-bottom: 17px;
  }

  .stage-results {
    display: grid;
    gap: 18px;
  }

  .stage-result-block h4,
  .overall-result-block h4 {
    margin: 0 0 10px;
    color: #68716b;
    font-size: 13px;
    line-height: 1.4;
  }

  .stage-result-block + .stage-result-block {
    padding-top: 18px;
    border-top: 1px solid #e0e4e1;
  }

  .stage-result-block .league-result {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .overall-result-block {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #e0e4e1;
  }

  .overall-result-block .league-result {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .league-result {
    display: flex;
    align-items: stretch;
    gap: 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e0e4e1;
  }

  .result-rank {
    min-width: 120px;
    padding-right: 28px;
    border-right: 1px solid #d8ddd9;
  }

  .result-rank span,
  .result-stats span,
  .cup-results span {
    display: block;
    margin-bottom: 4px;
    color: #68716b;
    font-size: 12px;
    line-height: 1.4;
  }

  .result-rank strong {
    font-size: 24px;
    line-height: 1.2;
  }

  .result-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  .result-stats strong {
    font-size: 15px;
    line-height: 1.4;
  }

  .cup-results {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    padding-top: 16px;
  }

  .cup-results strong {
    font-size: 14px;
    line-height: 1.4;
  }

  /* =========================
     選手一覧
     ========================= */

  .table-wrap {
    width: 100%;
    overflow-x: auto;
    background: white;
    border: 1px solid #cfd5d0;
  }

  table {
    width: 100%;
    min-width: 1100px;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    padding: 10px 11px;
    background: #e7ebe8;
    border-right: 1px solid #ccd2cd;
    border-bottom: 2px solid #aeb8b0;
    text-align: left;
    white-space: nowrap;
    font-size: 13px;
    line-height: 1.4;
  }

  td {
    padding: 9px 11px;
    border-right: 1px solid #e0e4e1;
    border-bottom: 1px solid #e0e4e1;
    white-space: nowrap;
    line-height: 1.5;
  }

  /*
    新日鐵室蘭用。

    ここでは table-layout:fixed を使わない。
    それを使うと他の列まで再配分されるため。

